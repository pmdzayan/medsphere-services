{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".eslintrc.js", ".prettierrc"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "inputs": ["src/**", "prisma/**", "tsconfig*.json", "package.json"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "jest.config.*", "tsconfig*.json", "package.json"]
    },
    "test:cov": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "jest.config.*", "tsconfig*.json", "package.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
