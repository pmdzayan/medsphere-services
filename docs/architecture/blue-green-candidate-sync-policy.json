{
  "schemaVersion": 1,
  "task": "UM14.2",
  "principle": "snapshot-rebuild-inactive-only",
  "sourceRole": "ACTIVE",
  "requiredTargetRole": "ROLLBACK",
  "targetRoleAfter": "CANDIDATE",
  "backup": {
    "format": "postgres-custom",
    "encryptedStorageAcknowledgementRequired": true,
    "forbidRepositoryStorage": true,
    "fileMode": "0600"
