{
  "name": "@medsphere/auth-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "worker:reservation-expiry": "node dist/reservation-expiry.worker.js",
    "worker:batch-expiry": "node dist/batch-expiry.worker.js",
    "test": "tsc -p tsconfig.spec.json --noEmit && jest",
    "test:cov": "tsc -p tsconfig.spec.json --noEmit && jest --coverage",
