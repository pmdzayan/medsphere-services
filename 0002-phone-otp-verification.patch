+      eventType: 'authentication.account.activated',
+      outcome: 'SUCCEEDED',
+      resourceType: 'TenantMembership',
+      resourceId: membership.id,
+      metadata: { verificationPolicy: 'PHONE_IDENTITY_ADULT_18_PLUS' },
