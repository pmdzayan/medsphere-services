{
  "name": "@medsphere/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:status": "prisma migrate status",
    "prisma:drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "prisma:verify": "pnpm prisma:validate && pnpm prisma:deploy && pnpm prisma:status && pnpm prisma:drift",
    "prisma:verify-upgrade": "node --check scripts/verify-s0.4-upgrade.mjs && node --check scripts/verify-s0.5-upgrade.mjs && node scripts/verify-s0.4-upgrade.mjs && node scripts/verify-s0.5-upgrade.mjs",
    "prisma:studio": "prisma studio",
    "build": "pnpm prisma:generate && tsc",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@medsphere/types": "workspace:*",
    "@prisma/client": "^5.10.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "prisma": "^5.10.2",
    "typescript": "^5.3.3"
  }
}
