generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  ROTATED
  EXPIRED
  REVOKED
  COMPROMISED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACCESS
}

enum ProviderType {
  PHARMACY
  HOSPITAL
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum ProductCategory {
  MEDICINE
  OTC
  COSMETIC
  AYURVEDIC
  SUPPLEMENT
  BABY_CARE
  PERSONAL_CARE
  MEDICAL_DEVICE
}

enum DosageForm {
  TABLET
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  CAPSULE
  DROPS
  INHALER
  SPRAY
  LOTION
  GEL
  POWDER
  SOLUTION
  SUSPENSION
}

enum RoleType {
  SYSTEM
  TENANT
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  RETURN_IN
  RETURN_OUT
  EXPIRED
  DAMAGED
}

// === MPI Enums ===
enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum IdentifierType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  HEALTH_INSURANCE_NO
  MRN
  CUSTOM
}

enum MatchConfidence {
  EXACT
  HIGH
  PROBABLE
  POSSIBLE
}

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid

  name        String
  slug        String   @unique
  email       String?  @unique

  isActive               Boolean  @default(true)
  selfRegistrationEnabled Boolean @default(false)

  version     Int      @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  memberships            TenantMembership[]
  roles                  Role[]
  providerVerifications  ProviderVerification[]
  providers              Provider[]
  auditLogs              AuditLog[]
  patients               Patient[]
  productCatalogs        ProductCatalog[]
  locations              Location[]
  encounters             Encounter[]
  financialAccounts      Account[]
  journalEntries         JournalEntry[]
  invoices               Invoice[]
  outboxEvents           OutboxEvent[]
  notificationTemplates  NotificationTemplate[]
  notificationConfigs    TenantNotificationConfig[]
   notificationLogs       NotificationLog[]
   documents              Document[]
   documentAccessLogs     DocumentAccessLog[]

}

model User {
  id            String      @id @default(uuid()) @db.Uuid

  email         String      @unique @db.Citext
  passwordHash  String

  firstName     String
  lastName      String

  phone         String?

  preferredLanguage String  @default("en")

  status        UserStatus  @default(ACTIVE)

  version       Int         @default(1)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

   memberships    TenantMembership[]
   privacy        UserPrivacy?
   auditLogs      AuditLog[]
   encounters     Encounter[]            @relation("PractitionerEncounters")
   notificationLogs NotificationLog[]
   documents        Document[]
   documentAccessLogs DocumentAccessLog[]
}

model TenantMembership {
  id          String           @id @default(uuid()) @db.Uuid

  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      MembershipStatus @default(PENDING)
  isDefault   Boolean          @default(false)
  joinedAt    DateTime?
  endedAt     DateTime?

  version     Int              @default(1)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  sessions    UserSession[]
  userRoles   UserRole[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model UserPrivacy {
  id            String   @id @default(uuid()) @db.Uuid

  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sharePhone    Boolean  @default(false)
  shareEmail    Boolean  @default(false)
  allowInAppChat Boolean @default(true)
  privatePickup Boolean  @default(false)
  hideSensitiveNotifications Boolean @default(true)
  preferredLanguage String @default("en")

  version       Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

}

model Role {
  id          String    @id @default(uuid()) @db.Uuid

  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name         String
  description  String?

  type         RoleType @default(TENANT)

  version      Int      @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid

  resource    String
  action      String
  description String?

  version      Int      @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
}

model UserRole {
  id                 String           @id @default(uuid()) @db.Uuid

  tenantMembershipId String           @db.Uuid
  tenantMembership   TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)

  roleId             String           @db.Uuid
  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt          DateTime         @default(now())

  @@unique([tenantMembershipId, roleId])
  @@index([tenantMembershipId])
  @@index([roleId])
}

model RolePermission {
  id            String      @id @default(uuid()) @db.Uuid

  roleId         String      @db.Uuid
  permissionId   String      @db.Uuid

  role           Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission  @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  createdAt      DateTime    @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserSession {
  id                String           @id @default(uuid()) @db.Uuid

  membershipId      String           @db.Uuid
  membership        TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  familyId           String           @db.Uuid
  refreshTokenHash   String           @unique @db.VarChar(64)

  ipAddress          String?          @db.Inet
  userAgent          String?          @db.VarChar(512)
  deviceName         String?          @db.VarChar(120)

  expiresAt          DateTime
  absoluteExpiresAt  DateTime
  lastUsedAt         DateTime         @default(now())

  status             SessionStatus    @default(ACTIVE)

  replacedById       String?          @unique @db.Uuid
  replacedBy         UserSession?     @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces           UserSession?     @relation("SessionRotation")

  revokedAt          DateTime?
  revocationReason   String?          @db.VarChar(120)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([membershipId, status])
  @@index([familyId, status])
  @@index([status, expiresAt])
  @@index([status, absoluteExpiresAt])
}

model ProviderVerification {
  id                        String             @id @default(uuid()) @db.Uuid

  tenantId                  String             @db.Uuid
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType              ProviderType
  status                    VerificationStatus @default(PENDING)

  licenseNumber             String
  licenseExpiryDate         DateTime
  businessRegistrationNumber String
  governmentIdReference     String

  verificationNotes         String?
  submittedAt               DateTime           @default(now())
  verifiedAt                DateTime?
  verifiedBy                String?            @db.Uuid

  version                   Int                @default(1)

  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  deletedAt                 DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([providerType])
}

model Provider {
  id            String       @id @default(uuid()) @db.Uuid

  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType  ProviderType
  businessName  String
  ownerName     String
  email         String
  phone         String
  address       String
  city          String
  state         String
  country       String
  postalCode    String
  latitude      Float
  longitude     Float
  geoHash       String?

  isVerified    Boolean      @default(false)
  isActive      Boolean      @default(true)

  inventory     Inventory[]
  batches       Batch[]

  version       Int          @default(1)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([providerType])
  @@index([email])
}

model Product {
  id                  String         @id @default(uuid()) @db.Uuid

  name                String
  genericName         String?
  brand               String
  category            ProductCategory
  subCategory         String?
  description         String?
  manufacturer        String
  dosageForm          DosageForm
  strength            String
  barcode             String?
  requiresPrescription Boolean       @default(false)

  isActive            Boolean        @default(true)
  inventory           Inventory[]
  batches             Batch[]

  version             Int            @default(1)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  @@index([category])
  @@index([name])
  @@index([barcode])
}

model Inventory {
  id                String             @id @default(uuid()) @db.Uuid

  providerId        String             @db.Uuid
  provider          Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)

  productId         String             @db.Uuid
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  sku               String?
  batchNumber       String
  expiryDate        DateTime
  quantity          Int
  reservedQuantity  Int                @default(0)
  sellingPrice      Decimal            @db.Decimal(10, 2)
  mrp               Decimal            @db.Decimal(10, 2)
  discountPercentage Decimal            @db.Decimal(5, 2)
  taxPercentage     Decimal            @db.Decimal(5, 2)
  minimumStockLevel  Int               @default(10)

  inStock           Boolean            @default(true)
  isVisible         Boolean            @default(true)

  version           Int                @default(1)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  stockMovements    StockMovement[]

  @@index([providerId])
  @@index([productId])
  @@index([expiryDate])
  @@index([providerId, inStock])
}

model Batch {
  id                String       @id @default(uuid()) @db.Uuid

  providerId        String       @db.Uuid
  provider          Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  productId         String       @db.Uuid
  product           Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime
  initialQuantity   Int
  currentQuantity   Int
  purchasePrice     Decimal      @db.Decimal(10, 2)
  sellingPrice      Decimal      @db.Decimal(10, 2)
  status            BatchStatus  @default(ACTIVE)

  version           Int          @default(1)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  stockMovements    StockMovement[]

  @@unique([providerId, productId, batchNumber])
  @@index([providerId])
  @@index([productId])
  @@index([expiryDate])
  @@index([status])
}

model StockMovement {
  id                String             @id @default(uuid()) @db.Uuid

  inventoryId       String             @db.Uuid
  inventory         Inventory          @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  batchId           String?            @db.Uuid
  batch             Batch?             @relation(fields: [batchId], references: [id], onDelete: Restrict)

  providerId        String             @db.Uuid
  productId         String             @db.Uuid

  type              StockMovementType
  quantity          Int
  quantityBefore    Int
  quantityAfter     Int

  referenceType     String?
  referenceId       String?
  reason            String?
  notes             String?

  userId            String             @db.Uuid

  version           Int                @default(1)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([inventoryId])
  @@index([batchId])
  @@index([providerId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model InventoryHistory {
  id                String             @id @default(uuid()) @db.Uuid

  inventoryId       String             @db.Uuid
  providerId        String             @db.Uuid
  productId         String             @db.Uuid
  batchId           String?            @db.Uuid

  type              StockMovementType
  quantity          Int
  quantityBefore    Int
  quantityAfter     Int
  referenceType     String?
  referenceId       String?
  reason            String?
  notes             String?

  userId            String             @db.Uuid

  createdAt         DateTime           @default(now())

  @@index([inventoryId])
  @@index([providerId])
  @@index([productId])
  @@index([batchId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid

  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId          String?  @db.Uuid
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action          String
  resource        String
  resourceId      String?

  correlationId   String?
  ipAddress       String?
  userAgent       String?

  oldValues       Json?
  newValues       Json?
  metadata        Json?

  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource])
  @@index([correlationId])
}

// === MPI Models ===

model Patient {
  id               String               @id @default(uuid()) @db.Uuid

  tenantId         String               @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mrn              String

  firstName        String
  middleName       String?
  lastName         String
  dateOfBirth      DateTime
  gender           Gender
  email            String?
  phone            String?
  nationalIdHash   String?
  address          Json?
  emergencyContact Json?
  bloodGroup       String?
  isDeceased       Boolean              @default(false)
  deceasedAt       DateTime?

  version          Int                  @default(1)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  identifiers      PatientIdentifier[]
  linksAsSource    PatientLink[]        @relation("SourcePatient")
  linksAsTarget    PatientLink[]        @relation("TargetPatient")
  encounters       Encounter[]
  invoices         Invoice[]
   insuranceClaims  InsuranceClaim[]
   documents        Document[]

   @@unique([tenantId, mrn])
  @@index([tenantId, lastName, firstName])
  @@index([nationalIdHash])
  @@index([phone])
  @@map("patients")
}

model PatientIdentifier {
  id             String         @id @default(uuid()) @db.Uuid

  patientId      String         @db.Uuid
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type           IdentifierType
  value          String
  valueHash      String
  isPrimary      Boolean        @default(false)

  createdAt      DateTime       @default(now())

  @@index([type, valueHash])
  @@map("patient_identifiers")
}

model PatientLink {
  id              String          @id @default(uuid()) @db.Uuid

  sourcePatientId String          @db.Uuid
  sourcePatient   Patient         @relation("SourcePatient", fields: [sourcePatientId], references: [id], onDelete: Cascade)

  targetPatientId String          @db.Uuid
  targetPatient   Patient         @relation("TargetPatient", fields: [targetPatientId], references: [id], onDelete: Cascade)

  confidence      MatchConfidence
  score           Float
  reason          String
  isVerified      Boolean         @default(false)
  verifiedBy      String?         @db.Uuid

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([sourcePatientId, targetPatientId])
  @@map("patient_links")
}

enum MedicalRecordType {
  PRESCRIPTION
  LAB_REPORT
  XRAY
  MRI
  CT_SCAN
  VACCINATION
  DISCHARGE_SUMMARY
  INSURANCE
  OTHER
}

model MedicalRecord {
  id              String            @id @default(uuid()) @db.Uuid

  userId          String            @db.Uuid

  recordType      MedicalRecordType
  title           String
  description     String?

  fileUrl         String
  fileName        String
  fileSize        Int
  mimeType        String

  recordDate      DateTime
  uploadedAt      DateTime          @default(now())

  version         Int               @default(1)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([recordType])
}

enum ReservationType {
  MEDICINE_PICKUP
  HOSPITAL_APPOINTMENT
  LAB_TEST
  VACCINATION
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid

  userId          String            @db.Uuid
  providerId      String            @db.Uuid

  reservationType ReservationType
  status          ReservationStatus @default(PENDING)

  scheduledAt     DateTime
  notes           String?

  version         Int               @default(1)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledAt])
}

// === Universal Multi-Warehouse Stock Ledger Models (S0.5+) ===

enum LocationType {
  CENTRAL_WAREHOUSE
  PHARMACY_COUNTER
  HOSPITAL_WARD
  LABORATORY
  SUPPLIER_EXTERNAL
  PATIENT_OUTBOUND
  WASTE_DISPOSAL
}

enum TransactionType {
  RECEIVE
  TRANSFER
  DISPENSE
  ADJUSTMENT_ADD
  ADJUSTMENT_SUB
  EXPIRED_DISCARD
  RETURN_INBOUND
}

enum ReservationStatusV2 {
  ACTIVE
  FULFILLED
  EXPIRED
  CANCELLED
}

model ProductCatalog {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  sku               String
  name              String
  genericName       String?
  description       String?
  category          String
  unitOfMeasure     String
  isControlled      Boolean      @default(false)
  requiresColdChain Boolean      @default(false)
  minStockThreshold Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches           StockBatch[]
  prescriptionItems PrescriptionItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([genericName])
  @@map("product_catalog")
}

model Location {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @db.Uuid
  name                 String
  type                 LocationType
  isStorage            Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceTransactions   StockLedger[]     @relation("SourceLocation")
  targetTransactions   StockLedger[]     @relation("TargetLocation")
  reservations         StockReservation[]

  @@unique([tenantId, name])
  @@map("locations")
}

model StockBatch {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  productId         String             @db.Uuid
  batchNumber       String
  manufacturedDate  DateTime?
  expiryDate        DateTime
  unitCost          Float
  sellingPrice      Float
  initialQuantity   Int
  currentQuantity   Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  product           ProductCatalog     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ledgerEntries     StockLedger[]
  reservations      StockReservation[]

  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId, productId, expiryDate])
  @@index([batchNumber])
  @@map("stock_batches")
}

model StockLedger {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  transactionType  TransactionType
  productId        String          @db.Uuid
  batchId          String          @db.Uuid
  sourceLocationId String          @db.Uuid
  targetLocationId String          @db.Uuid
  quantity         Int
  referenceType    String?
  referenceId      String?
  correlationId    String?
  createdAt        DateTime        @default(now())

  batch            StockBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceLocation   Location        @relation("SourceLocation", fields: [sourceLocationId], references: [id], onDelete: Cascade)
  targetLocation   Location        @relation("TargetLocation", fields: [targetLocationId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([tenantId, batchId])
  @@index([referenceType, referenceId])
  @@map("stock_ledger")
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  locationId  String            @db.Uuid
  productId   String            @db.Uuid
  batchId     String            @db.Uuid
  quantity    Int
  status      ReservationStatusV2 @default(ACTIVE)
  expiresAt   DateTime
  referenceId String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  location    Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  batch       StockBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, locationId, productId, status])
  @@map("stock_reservations")
}

// === Clinical Encounter & Prescription Models (Gate 4) ===

enum EncounterStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum EncounterType {
  AMBULATORY
  EMERGENCY
  INPATIENT
  TELEMEDICINE
}

enum PrescriptionStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_DISPENSED
  FULLY_DISPENSED
  CANCELLED
}

model Encounter {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  patientId       String          @db.Uuid
  practitionerId  String          @db.Uuid
  locationId      String?         @db.Uuid
  type            EncounterType
  status          EncounterStatus @default(PLANNED)
  chiefComplaint  String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    User            @relation("PractitionerEncounters", fields: [practitionerId], references: [id], onDelete: Cascade)
  clinicalNotes   ClinicalNote[]
  vitalSigns      VitalSign[]
  prescriptions   Prescription[]
  invoices        Invoice[]

  @@index([tenantId, patientId])
  @@index([tenantId, practitionerId])
  @@index([tenantId, status])
  @@map("encounters")
}

model ClinicalNote {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  encounterId  String      @db.Uuid
  authorId     String      @db.Uuid
  subjective   String?
  objective    String?
  assessment   String?
  plan         String?
  isFinalized  Boolean     @default(false)
  finalizedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  encounter    Encounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([tenantId, encounterId])
  @@map("clinical_notes")
}

model VitalSign {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @db.Uuid
  encounterId         String     @db.Uuid
  patientId           String     @db.Uuid
  systolicBp          Int?
  diastolicBp         Int?
  heartRate           Int?
  temperature         Float?
  spO2                Float?
  respiratoryRate     Int?
  weight              Float?
  height              Float?
  bmi                 Float?
  recordedAt          DateTime   @default(now())

  encounter           Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("vital_signs")
}

model Prescription {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  encounterId     String             @db.Uuid
  patientId       String             @db.Uuid
  practitionerId  String             @db.Uuid
  targetLocationId String            @db.Uuid
  status          PrescriptionStatus @default(DRAFT)
  notes           String?
  submittedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  encounter       Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  items           PrescriptionItem[]

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String         @id @default(uuid()) @db.Uuid
  prescriptionId String         @db.Uuid
  productId      String         @db.Uuid
  dosage         String
  frequency      String
  durationDays   Int
  quantity       Int
  instructions   String?

  prescription   Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product        ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

// === Financial Ledger & Billing Models (Gate 5) ===

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  VOID
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  MOBILE_MONEY
  INSURANCE_DIRECT
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  code          String
  name          String
  type          AccountType
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalLines  JournalLine[]

  @@unique([tenantId, code])
  @@map("financial_accounts")
}

model JournalEntry {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  entryNumber   String        @default(uuid())
  referenceType String?
  referenceId   String?
  memo          String?
  postedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines         JournalLine[]

  @@index([tenantId, postedAt])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @db.Uuid
  accountId      String       @db.Uuid
  debit          Float        @default(0.0)
  credit         Float        @default(0.0)

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("journal_lines")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  invoiceNumber  String
  patientId      String        @db.Uuid
  encounterId    String?       @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  subtotal       Float
  taxAmount      Float         @default(0.0)
  discountAmount Float         @default(0.0)
  totalAmount    Float
  paidAmount     Float         @default(0.0)
  balanceDue     Float
  dueDate        DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter      Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       Payment[]
  claims         InsuranceClaim[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceItem {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @db.Uuid
  description  String
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  resourceType String?
  resourceId   String?

  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  invoiceId   String        @db.Uuid
  amount      Float
  method      PaymentMethod
  referenceNo String?
  paidAt      DateTime      @default(now())

  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("payments")
}

model InsuranceClaim {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  invoiceId       String      @db.Uuid
  patientId       String      @db.Uuid
  payerName       String
  policyNumber    String
  claimNumber     String      @default(uuid())
  claimedAmount   Float
  approvedAmount  Float       @default(0.0)
  status          ClaimStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  adjudicatedAt   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@map("insurance_claims")
}

// === Event Bus / Transactional Outbox Models (Gate 6) ===

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  lastError     String?
  scheduledFor  DateTime     @default(now())
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([tenantId, eventType])
  @@index([correlationId])
  @@map("outbox_events")
}

// === Multi-Tenant Notification Platform (Gate 7) ===

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

/// Provider types for notification delivery channels.
/// Named `NotificationProviderType` to avoid collision with the existing
/// healthcare `ProviderType` enum (PHARMACY, HOSPITAL).
enum NotificationProviderType {
  SMTP
  SENDGRID
  TWILIO
  AWS_SES
  FCM
  WHATSAPP_BUSINESS
  MOCK
}

model NotificationTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  code        String              // Unique template identifier (e.g., "RX_SUBMITTED_PATIENT")
  channel     NotificationChannel
  subject     String?             // Required for Email/Push
  body        String              // Text/HTML template with {{placeholders}}
  variables   Json                // List of allowed variable keys e.g. ["patientName", "rxNumber"]
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code, channel])
  @@map("notification_templates")
}

model TenantNotificationConfig {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  channel     NotificationChannel
  provider    NotificationProviderType
  credentials Json                // Encrypted API keys, tokens, or SMTP credentials
  isDefault   Boolean             @default(true)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, provider])
  @@map("tenant_notification_configs")
}

model NotificationLog {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  userId        String?             @db.Uuid
  channel       NotificationChannel
  recipient     String              // Email address, Phone number, or Device Token
  subject       String?
  body          String
  status        NotificationStatus  @default(PENDING)
  errorMessage  String?
  correlationId String?
  metadata      Json?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
   @@index([correlationId])
   @@map("notification_logs")
}

// === Document Management & Secure Object Storage (Gate 8) ===

enum DocumentCategory {
  CLINICAL_NOTE_ATTACHMENT
  LAB_REPORT_PDF
  PRESCRIPTION_SCAN
  RADIOLOGY_DICOM
  PATIENT_IDENTIFICATION
  INSURANCE_CARD
  GENERAL_ATTACHMENT
}

enum StorageProviderType {
  S3
  MINIO
  LOCAL_DISK
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  patientId      String?          @db.Uuid
  uploaderId     String           @db.Uuid
  category       DocumentCategory
  title          String
  description    String?
  originalName   String
  mimeType       String
  fileSize       Int              // Size in Bytes
  storageBucket  String
  storageKey     String           // Storage path/key e.g., "tenants/{tenantId}/docs/{uuid}.pdf"
  checksumSha256 String           // SHA-256 hash for file integrity verification
  isEncrypted    Boolean          @default(true)
  isSigned       Boolean          @default(false)
  signatureData  Json?            // Digital signature payload (hash, public key, timestamp)
  metadata       Json?            // Arbitrary key-value tags
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  uploader       User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  accessLogs     DocumentAccessLog[]

  @@index([tenantId, patientId])
  @@index([tenantId, category])
  @@index([checksumSha256])
  @@map("documents")
}

model DocumentAccessLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  documentId    String   @db.Uuid
  accessedById  String   @db.Uuid
  action        String   // E.g., "METADATA_READ", "PRESIGNED_DOWNLOAD_URL_GENERATED", "SIGNED"
  ipAddress     String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accessedBy    User     @relation(fields: [accessedById], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([accessedById])
  @@map("document_access_logs")
}
