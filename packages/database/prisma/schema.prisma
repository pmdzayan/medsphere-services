generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  ROTATED
  EXPIRED
  REVOKED
  COMPROMISED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACCESS
}

enum ProviderType {
  PHARMACY
  HOSPITAL
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum ProductCategory {
  MEDICINE
  OTC
  COSMETIC
  AYURVEDIC
  SUPPLEMENT
  BABY_CARE
  PERSONAL_CARE
  MEDICAL_DEVICE
}

enum DosageForm {
  TABLET
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  CAPSULE
  DROPS
  INHALER
  SPRAY
  LOTION
  GEL
  POWDER
  SOLUTION
  SUSPENSION
}

enum RoleType {
  SYSTEM
  TENANT
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  RETURN_IN
  RETURN_OUT
  EXPIRED
  DAMAGED
}

// === MPI Enums ===
enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum IdentifierType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  HEALTH_INSURANCE_NO
  MRN
  CUSTOM
}

enum MatchConfidence {
  EXACT
  HIGH
  PROBABLE
  POSSIBLE
}

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid

  name        String
  slug        String   @unique
  email       String?  @unique

  isActive               Boolean  @default(true)
  selfRegistrationEnabled Boolean @default(false)

  version     Int      @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  memberships            TenantMembership[]
  roles                  Role[]
  providerVerifications  ProviderVerification[]
  providers              Provider[]
  auditLogs              AuditLog[]
  patients               Patient[]

  @@index([slug])
}

model User {
  id            String      @id @default(uuid()) @db.Uuid

  email         String      @unique @db.Citext
  passwordHash  String

  firstName     String
  lastName      String

  phone         String?

  preferredLanguage String  @default("en")

  status        UserStatus  @default(ACTIVE)

  version       Int         @default(1)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  memberships    TenantMembership[]
  privacy        UserPrivacy?
  auditLogs      AuditLog[]
}

model TenantMembership {
  id          String           @id @default(uuid()) @db.Uuid

  tenantId    String           @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      MembershipStatus @default(PENDING)
  isDefault   Boolean          @default(false)
  joinedAt    DateTime?
  endedAt     DateTime?

  version     Int              @default(1)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  sessions    UserSession[]
  userRoles   UserRole[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model UserPrivacy {
  id            String   @id @default(uuid()) @db.Uuid

  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sharePhone    Boolean  @default(false)
  shareEmail    Boolean  @default(false)
  allowInAppChat Boolean @default(true)
  privatePickup Boolean  @default(false)
  hideSensitiveNotifications Boolean @default(true)
  preferredLanguage String @default("en")

  version       Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid

  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name         String
  description  String?

  type         RoleType @default(TENANT)

  version      Int      @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid

  resource    String
  action      String
  description String?

  version      Int      @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
}

model UserRole {
  id                 String           @id @default(uuid()) @db.Uuid

  tenantMembershipId String           @db.Uuid
  tenantMembership   TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)

  roleId             String           @db.Uuid
  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt          DateTime         @default(now())

  @@unique([tenantMembershipId, roleId])
  @@index([tenantMembershipId])
  @@index([roleId])
}

model RolePermission {
  id            String      @id @default(uuid()) @db.Uuid

  roleId         String      @db.Uuid
  permissionId   String      @db.Uuid

  role           Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission  @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  createdAt      DateTime    @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserSession {
  id                String           @id @default(uuid()) @db.Uuid

  membershipId      String           @db.Uuid
  membership        TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  familyId           String           @db.Uuid
  refreshTokenHash   String           @unique @db.VarChar(64)

  ipAddress          String?          @db.Inet
  userAgent          String?          @db.VarChar(512)
  deviceName         String?          @db.VarChar(120)

  expiresAt          DateTime
  absoluteExpiresAt  DateTime
  lastUsedAt         DateTime         @default(now())

  status             SessionStatus    @default(ACTIVE)

  replacedById       String?          @unique @db.Uuid
  replacedBy         UserSession?     @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces           UserSession?     @relation("SessionRotation")

  revokedAt          DateTime?
  revocationReason   String?          @db.VarChar(120)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([membershipId, status])
  @@index([familyId, status])
  @@index([status, expiresAt])
  @@index([status, absoluteExpiresAt])
}

model ProviderVerification {
  id                        String             @id @default(uuid()) @db.Uuid

  tenantId                  String             @db.Uuid
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType              ProviderType
  status                    VerificationStatus @default(PENDING)

  licenseNumber             String
  licenseExpiryDate         DateTime
  businessRegistrationNumber String
  governmentIdReference     String

  verificationNotes         String?
  submittedAt               DateTime           @default(now())
  verifiedAt                DateTime?
  verifiedBy                String?            @db.Uuid

  version                   Int                @default(1)

  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  deletedAt                 DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([providerType])
}

model Provider {
  id            String       @id @default(uuid()) @db.Uuid

  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType  ProviderType
  businessName  String
  ownerName     String
  email         String
  phone         String
  address       String
  city          String
  state         String
  country       String
  postalCode    String
  latitude      Float
  longitude     Float
  geoHash       String?

  isVerified    Boolean      @default(false)
  isActive      Boolean      @default(true)

  inventory     Inventory[]
  batches       Batch[]

  version       Int          @default(1)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([providerType])
  @@index([email])
}

model Product {
  id                  String         @id @default(uuid()) @db.Uuid

  name                String
  genericName         String?
  brand               String
  category            ProductCategory
  subCategory         String?
  description         String?
  manufacturer        String
  dosageForm          DosageForm
  strength            String
  barcode             String?
  requiresPrescription Boolean       @default(false)

  isActive            Boolean        @default(true)
  inventory           Inventory[]
  batches             Batch[]

  version             Int            @default(1)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  @@index([category])
  @@index([name])
  @@index([barcode])
}

model Inventory {
  id                String             @id @default(uuid()) @db.Uuid

  providerId        String             @db.Uuid
  provider          Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)

  productId         String             @db.Uuid
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  sku               String?
  batchNumber       String
  expiryDate        DateTime
  quantity          Int
  reservedQuantity  Int                @default(0)
  sellingPrice      Decimal            @db.Decimal(10, 2)
  mrp               Decimal            @db.Decimal(10, 2)
  discountPercentage Decimal            @db.Decimal(5, 2)
  taxPercentage     Decimal            @db.Decimal(5, 2)
  minimumStockLevel  Int               @default(10)

  inStock           Boolean            @default(true)
  isVisible         Boolean            @default(true)

  version           Int                @default(1)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  stockMovements    StockMovement[]

  @@index([providerId])
  @@index([productId])
  @@index([expiryDate])
  @@index([providerId, inStock])
}

model Batch {
  id                String       @id @default(uuid()) @db.Uuid

  providerId        String       @db.Uuid
  provider          Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  productId         String       @db.Uuid
  product           Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime
  initialQuantity   Int
  currentQuantity   Int
  purchasePrice     Decimal      @db.Decimal(10, 2)
  sellingPrice      Decimal      @db.Decimal(10, 2)
  status            BatchStatus  @default(ACTIVE)

  version           Int          @default(1)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  stockMovements    StockMovement[]

  @@unique([providerId, productId, batchNumber])
  @@index([providerId])
  @@index([productId])
  @@index([expiryDate])
  @@index([status])
}

model StockMovement {
  id                String             @id @default(uuid()) @db.Uuid

  inventoryId       String             @db.Uuid
  inventory         Inventory          @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  batchId           String?            @db.Uuid
  batch             Batch?             @relation(fields: [batchId], references: [id], onDelete: Restrict)

  providerId        String             @db.Uuid
  productId         String             @db.Uuid

  type              StockMovementType
  quantity          Int
  quantityBefore    Int
  quantityAfter     Int

  referenceType     String?
  referenceId       String?
  reason            String?
  notes             String?

  userId            String             @db.Uuid

  version           Int                @default(1)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([inventoryId])
  @@index([batchId])
  @@index([providerId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model InventoryHistory {
  id                String             @id @default(uuid()) @db.Uuid

  inventoryId       String             @db.Uuid
  providerId        String             @db.Uuid
  productId         String             @db.Uuid
  batchId           String?            @db.Uuid

  type              StockMovementType
  quantity          Int
  quantityBefore    Int
  quantityAfter     Int
  referenceType     String?
  referenceId       String?
  reason            String?
  notes             String?

  userId            String             @db.Uuid

  createdAt         DateTime           @default(now())

  @@index([inventoryId])
  @@index([providerId])
  @@index([productId])
  @@index([batchId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid

  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId          String?  @db.Uuid
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action          String
  resource        String
  resourceId      String?

  correlationId   String?
  ipAddress       String?
  userAgent       String?

  oldValues       Json?
  newValues       Json?
  metadata        Json?

  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource])
  @@index([correlationId])
}

// === MPI Models ===

model Patient {
  id               String               @id @default(uuid()) @db.Uuid

  tenantId         String               @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mrn              String

  firstName        String
  middleName       String?
  lastName         String
  dateOfBirth      DateTime
  gender           Gender
  email            String?
  phone            String?
  nationalIdHash   String?
  address          Json?
  emergencyContact Json?
  bloodGroup       String?
  isDeceased       Boolean              @default(false)
  deceasedAt       DateTime?

  version          Int                  @default(1)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  identifiers      PatientIdentifier[]
  linksAsSource    PatientLink[]        @relation("SourcePatient")
  linksAsTarget    PatientLink[]        @relation("TargetPatient")

  @@unique([tenantId, mrn])
  @@index([tenantId, lastName, firstName])
  @@index([nationalIdHash])
  @@index([phone])
  @@map("patients")
}

model PatientIdentifier {
  id             String         @id @default(uuid()) @db.Uuid

  patientId      String         @db.Uuid
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type           IdentifierType
  value          String
  valueHash      String
  isPrimary      Boolean        @default(false)

  createdAt      DateTime       @default(now())

  @@index([type, valueHash])
  @@map("patient_identifiers")
}

model PatientLink {
  id              String          @id @default(uuid()) @db.Uuid

  sourcePatientId String          @db.Uuid
  sourcePatient   Patient         @relation("SourcePatient", fields: [sourcePatientId], references: [id], onDelete: Cascade)

  targetPatientId String          @db.Uuid
  targetPatient   Patient         @relation("TargetPatient", fields: [targetPatientId], references: [id], onDelete: Cascade)

  confidence      MatchConfidence
  score           Float
  reason          String
  isVerified      Boolean         @default(false)
  verifiedBy      String?         @db.Uuid

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([sourcePatientId, targetPatientId])
  @@map("patient_links")
}

enum MedicalRecordType {
  PRESCRIPTION
  LAB_REPORT
  XRAY
  MRI
  CT_SCAN
  VACCINATION
  DISCHARGE_SUMMARY
  INSURANCE
  OTHER
}

model MedicalRecord {
  id              String            @id @default(uuid()) @db.Uuid

  userId          String            @db.Uuid

  recordType      MedicalRecordType
  title           String
  description     String?

  fileUrl         String
  fileName        String
  fileSize        Int
  mimeType        String

  recordDate      DateTime
  uploadedAt      DateTime          @default(now())

  version         Int               @default(1)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([recordType])
}

enum ReservationType {
  MEDICINE_PICKUP
  HOSPITAL_APPOINTMENT
  LAB_TEST
  VACCINATION
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid

  userId          String            @db.Uuid
  providerId      String            @db.Uuid

  reservationType ReservationType
  status          ReservationStatus @default(PENDING)

  scheduledAt     DateTime
  notes           String?

  version         Int               @default(1)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledAt])
}