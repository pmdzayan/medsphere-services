generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  ROTATED
  EXPIRED
  REVOKED
  COMPROMISED
}

enum RefreshCredentialStatus {
  ACTIVE
  USED
  REVOKED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AuditActorType {
  TENANT_USER
  PLATFORM_USER
  SYSTEM
}

enum AuditScope {
  TENANT
  PLATFORM
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

enum ProviderType {
  PHARMACY
  HOSPITAL
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum AccountVerificationMethod {
  PHONE
  IDENTITY
  AGE
}

enum AccountVerificationProvider {
  MOCK
  EXTERNAL_IDENTITY_PROVIDER
  SMS_OTP
}

enum ProductCategory {
  MEDICINE
  OTC
  COSMETIC
  AYURVEDIC
  SUPPLEMENT
  BABY_CARE
  PERSONAL_CARE
  MEDICAL_DEVICE
}

enum DosageForm {
  TABLET
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  CAPSULE
  DROPS
  INHALER
  SPRAY
  LOTION
  GEL
  POWDER
  SOLUTION
  SUSPENSION
}

enum RoleType {
  SYSTEM
  TENANT
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  QUARANTINED
}

enum BatchQuarantineReason {
  QUALITY_SUSPECT
  TEMPERATURE_EXCURSION
  PACKAGING_COMPROMISED
  STORAGE_DEVIATION
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  RETURN_IN
  RETURN_OUT
  EXPIRED
  DAMAGED
}

/// Task 0025: closed catalogue of accepted BATCH-BOUND physical-stock evidence
/// sources. Every value is persisted in `BatchStockObservation`, which is
/// strictly batch-bound (requires an AIM `Batch` id via composite FKs).
/// `MANUAL_PHYSICAL_COUNT` and `POS_SYNC` are valid only when the external
/// observation has been normalized to a real AIM batch. `PHARMACIST_CONFIRMATION`
/// is deliberately NOT in this catalogue: a pharmacist confirmation for Live
/// Availability Request is temporary provider/product evidence and must not
/// require an AIM batch; it is reserved for a future provider/product-level
/// evidence model combined by the canonical trust layer.
enum AvailabilityEvidenceSource {
  AIM_MANAGED_INVENTORY
  MANUAL_PHYSICAL_COUNT
  POS_SYNC
}

/// Task 0026: lifecycle of a provider/product live availability request.
/// The public V1 workflow is simply "please confirm whether this provider
/// currently has this product available" -- it carries no patient medical
/// data, contact information, or free-form patient text.
enum AvailabilityRequestStatus {
  PENDING
  RESPONDED
  EXPIRED
}

/// Task 0026: the closed set of temporary provider/product availability
/// outcomes an authorized pharmacist/staff member can confirm. CHECK_LATER is
/// available to a patient-facing surface only as "confirmation required" with
/// a bounded retryAfterAt; it never claims current availability.
enum PharmacistConfirmationOutcome {
  AVAILABLE
  UNAVAILABLE
  CHECK_LATER
}

/// Task 0026: closed catalogue of provider/product-level live evidence
/// sources. PHARMACIST_CONFIRMATION is the only Task 0026 source and is never
/// written to the batch-bound `BatchStockObservation` table (Task 0025
/// deliberately reserved it for this separate model).
enum ProviderProductAvailabilityEvidenceSource {
  PHARMACIST_CONFIRMATION
}

enum MedicineReservationStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

enum MedicineAllocationStatus {
  HELD
  CONSUMED
  RELEASED
}

enum MedicineReservationCommandType {
  CONFIRM
  READY
  COMPLETE
  CANCEL
  EXPIRE
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  FAILED
  DELIVERED
  DEAD_LETTER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationRecipientType {
  TENANT_MEMBERSHIP
  TENANT_OPERATIONAL_ROUTE
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  FAILED
  DELIVERED
  DEAD_LETTER
}

enum NotificationAttemptOutcome {
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum OrganizationType {
  /// Fail-closed value for tenants created before organization-type
  /// classification was introduced. Never accepted by public onboarding.
  UNSPECIFIED
  PHARMACY
  HOSPITAL
  LABORATORY
  CLINIC
  BLOOD_BANK
  SUPPLIER
  NONE
}

enum JoinCodeStatus {
  ACTIVE
  REVOKED
}

enum ConsentCategory {
  LOCATION_USE
  NOTIFICATIONS_RESERVATIONS
  NOTIFICATIONS_OPERATIONAL
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

/// Task 0021: platform-account lifecycle. Platform authority is granted ONLY
/// through a PlatformAccount + live PlatformRoleAssignment -- never through
/// tenant membership (TENANT AUTHORITY != PLATFORM AUTHORITY).
enum PlatformAccountStatus {
  ACTIVE
  SUSPENDED
}

/// Task 0021: invitation lifecycle. Invitations are single-use bearer proofs
/// stored only as an HMAC digest; plaintext secrets are never persisted.
enum PlatformInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Task 0021: dedicated platform-session lifecycle. Distinct from the
/// tenant-scoped UserSession so a platform administrator's platform session
/// can never be confused with (or grant) a tenant membership.
enum PlatformSessionStatus {
  ACTIVE
  ROTATED
  EXPIRED
  REVOKED
  COMPROMISED
}

enum PlatformRefreshCredentialStatus {
  ACTIVE
  USED
  REVOKED
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid

  name  String
  slug  String  @unique
  email String? @unique

  /// The organization's own accepted category, verified server-side at
  /// join-code redemption time against the type the registering user
  /// selected -- never trusted from the client alone (see ADR for this
  /// task). UNSPECIFIED preserves legacy tenants until an operator
  /// classifies them; NONE identifies only the dedicated personal-account
  /// tenant and is never assigned to legacy organizations by migration.
  organizationType OrganizationType @default(UNSPECIFIED)

  isActive                Boolean @default(true)
  selfRegistrationEnabled Boolean @default(false)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships                         TenantMembership[]
  sessions                            UserSession[]
  membershipProviderAccess            MembershipProviderAccess[]
  roles                               Role[]
  auditEvents                         AuditEvent[]
  providerVerifications               ProviderVerification[]
  providers                           Provider[]
  inventory                           Inventory[]
  batches                             Batch[]
  stockMovements                      StockMovement[]
  inventoryConfigurationCommands      InventoryConfigurationCommand[]
  medicineReservations                MedicineReservation[]
  reservationItems                    MedicineReservationItem[]
  reservationAllocations              MedicineReservationAllocation[]
  reservationCommands                 MedicineReservationCommand[]
  inventoryTransfers                  InventoryTransfer[]
  batchExpiryRecords                  BatchExpiryRecord[]
  batchQuarantineRecords              BatchQuarantineRecord[]
  outboxEvents                        OutboxEvent[]
  eventInboxReceipts                  EventInboxReceipt[]
  notificationDeliveries              NotificationDelivery[]
  notificationDeliveryAttempts        NotificationDeliveryAttempt[]
  phoneOtpChallenges                  PhoneOtpChallenge[]
  organizationJoinCodes               OrganizationJoinCode[]
  batchStockObservations              BatchStockObservation[]
  availabilityRequests                AvailabilityRequest[]
  providerProductAvailabilityEvidence ProviderProductAvailabilityEvidence[]

  @@index([slug])
}

/// Reusable, revocable organization join code (see ADR-025). Possessing a
/// valid code only associates a public registration request with this tenant;
/// it never grants a role or activates a membership. The plaintext code is
/// never persisted: only an HMAC-SHA256 digest keyed by
/// ORG_JOIN_CODE_PEPPER is stored.
model OrganizationJoinCode {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// HMAC-SHA256 hex digest of the normalized code. Never the plaintext
  /// code. Globally unique and looked up directly at redemption time,
  /// since the client submits only the raw code, not a tenant hint.
  codeHash String @unique @db.VarChar(64)

  status JoinCodeStatus @default(ACTIVE)

  /// Null means no expiry is enforced; revocation/status remain the
  /// only lifecycle control in that case.
  expiresAt DateTime?
  revokedAt DateTime?

  /// Reusable by design (see model doc) -- tracks how many onboarding
  /// requests have redeemed this code for operator visibility only. Not
  /// a single-use consumption counter.
  redemptionCount Int @default(0)

  createdByMembershipId String           @db.Uuid
  createdByMembership   TenantMembership @relation("OrganizationJoinCodeCreatedBy", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique @db.Citext
  passwordHash String?

  firstName String
  lastName  String

  phone String?

  preferredLanguage String @default("en")

  status UserStatus @default(ACTIVE)

  phoneVerifiedAt            DateTime?
  identityVerificationStatus VerificationStatus @default(PENDING)
  ageVerificationStatus      VerificationStatus @default(PENDING)
  ageVerified18Plus          Boolean?

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships                  TenantMembership[]
  sessions                     UserSession[]
  platformAuditEvents          AuditEvent[]                          @relation("AuditEventPlatformActor")
  actorAuditEvents             AuditEvent[]                          @relation("AuditEventActorUser")
  privacy                      UserPrivacy?
  medicineReservations         MedicineReservation[]
  verificationAttempts         AccountVerificationAttempt[]
  externalAuthIdentities       ExternalAuthIdentity[]
  phoneOtpChallenges           PhoneOtpChallenge[]
  consentRecords               ConsentRecord[]
  platformAccount              PlatformAccount?                      @relation("PlatformAccountUser")
  platformSessions             PlatformSession[]                     @relation("PlatformSessionUser")
  createdPlatformAssignments   PlatformRoleAssignment[]              @relation("PlatformAssignmentCreatedBy")
  createdPlatformInvitations   PlatformInvitation[]                  @relation("PlatformInvitationCreatedBy")
  acceptedPlatformInvitations  PlatformInvitation[]                  @relation("PlatformInvitationAccepted")
  revokedPlatformInvitations   PlatformInvitation[]                  @relation("PlatformInvitationRevokedBy")
  availabilityResponseEvidence ProviderProductAvailabilityEvidence[]
}

model ExternalAuthIdentity {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider ExternalAuthProvider
  subject  String               @db.VarChar(255)

  email         String? @db.Citext
  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, subject])
  @@index([userId])
}

enum ExternalAuthProvider {
  GOOGLE
}

model AccountVerificationAttempt {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method   AccountVerificationMethod
  provider AccountVerificationProvider
  status   VerificationStatus          @default(PENDING)

  providerReference String?   @db.VarChar(240)
  idempotencyKey    String    @db.VarChar(120)
  commandHash       String    @db.VarChar(64)
  verifiedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider, method, idempotencyKey])
  @@index([userId, method, status, createdAt(sort: Desc)])
}

/// Live, mutable, single-use OTP challenge state -- deliberately separate
/// from the immutable AccountVerificationAttempt audit trail. Exactly one
/// active challenge exists per (tenant, user); a new OTP request overwrites
/// it after the resend-cooldown check. Only a cryptographic representation
/// of the code is stored, never the plaintext OTP.
model PhoneOtpChallenge {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone    String @db.VarChar(20)
  codeHash String @db.VarChar(64)

  attempts        Int       @default(0)
  expiresAt       DateTime
  consumedAt      DateTime?
  lastRequestedAt DateTime  @default(now())

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([expiresAt])
}

model TenantMembership {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status    MembershipStatus @default(PENDING)
  isDefault Boolean          @default(false)
  joinedAt  DateTime?
  endedAt   DateTime?

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions                     UserSession[]
  roleAssignments              MembershipRole[]
  auditEvents                  AuditEvent[]
  stockMovements               StockMovement[]
  providerAccess               MembershipProviderAccess[]
  batchQuarantineRecords       BatchQuarantineRecord[]
  outboxEvents                 OutboxEvent[]
  createdOrganizationJoinCodes OrganizationJoinCode[]                @relation("OrganizationJoinCodeCreatedBy")
  availabilityResponseEvidence ProviderProductAvailabilityEvidence[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@unique([id, userId, tenantId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model UserPrivacy {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sharePhone                 Boolean @default(false)
  shareEmail                 Boolean @default(false)
  allowInAppChat             Boolean @default(true)
  privatePickup              Boolean @default(false)
  hideSensitiveNotifications Boolean @default(true)
  preferredLanguage          String  @default("en")

  /// Task 0013: MedSphere-preference (not browser permission) for
  /// whether the person wants reservation-update notifications, when
  /// their browser notification permission is separately granted. A
  /// true value here never causes a notification to be sent if the
  /// browser permission is denied/unsupported -- see the frontend
  /// browser-permissions boundary, which always checks both states.
  wantsReservationNotifications Boolean @default(false)
  /// Same distinction, for operational/expiry/stock alerts aimed at
  /// authorized staff.
  wantsOperationalAlerts        Boolean @default(false)

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Append-only consent event log (Task 0013). Never updated or deleted --
/// a withdrawal is a NEW row with status=WITHDRAWN, never a mutation of
/// the granting row, so historical evidence of what was actually granted
/// and when is preserved even after withdrawal. The user's *current*
/// effective consent for a category is always the single latest row for
/// that (userId, category) pair -- there is deliberately no separate
/// "current state" table to keep out of sync with this log.
model ConsentRecord {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category ConsentCategory
  status   ConsentStatus

  /// Schema version of the consent category's disclosure text at the
  /// time this event was recorded, so a future copy change can be
  /// distinguished from a no-op re-confirmation.
  version Int @default(1)

  /// Bounded, non-identifying context string (e.g. "settings_privacy_page",
  /// "nearby_search_prompt") -- never free-form user text, never a URL
  /// with query parameters, never anything from request headers.
  source String @db.VarChar(64)

  createdAt DateTime @default(now())

  @@index([userId, category, createdAt])
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name        String
  description String?

  type RoleType @default(TENANT)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roleAssignments MembershipRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Permission {
  id          String   @id @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String   @db.VarChar(240)
  createdAt   DateTime @default(now())

  rolePermissions         RolePermission[]
  platformRolePermissions PlatformRolePermission[]
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  role       Role             @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([membershipId, roleId])
  @@index([tenantId, membershipId])
  @@index([tenantId, roleId])
}

model MembershipProviderAccess {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  providerId   String @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  provider   Provider         @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([membershipId, providerId])
  @@index([tenantId, membershipId])
  @@index([tenantId, providerId])
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([tenantId, roleId])
  @@index([permissionId])
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  membershipId String           @db.Uuid
  membership   TenantMembership @relation(fields: [membershipId, userId, tenantId], references: [id, userId, tenantId], onDelete: Cascade)

  familyId         String @db.Uuid
  refreshTokenHash String @unique @db.VarChar(64)

  ipAddress  String? @db.Inet
  userAgent  String? @db.VarChar(512)
  deviceName String? @db.VarChar(120)

  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime @default(now())

  status SessionStatus @default(ACTIVE)

  /// Task 0014: workstation-lock state. When lockedAt is non-null the
  /// session is locked and protected actions must not execute through it.
  /// securityVersion increments on every lock so access tokens issued
  /// before the lock are invalidated (fail-closed). Unlock rotates the
  /// session and issues a fresh access token carrying the new version.
  lockedAt        DateTime?
  lockReason      String?   @db.VarChar(120)
  unlockedAt      DateTime?
  unlockMethod    String?   @db.VarChar(40)
  securityVersion Int       @default(1)

  /// Task 0014: server-authoritative time of the most recent real
  /// credential proof. Normal refresh must carry this value forward
  /// unchanged; login, successful unlock, or explicit re-authentication
  /// may advance it.
  recentAuthenticatedAt DateTime?

  replacedById String?      @unique @db.Uuid
  replacedBy   UserSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     UserSession? @relation("SessionRotation")

  version Int @default(1)

  revokedAt        DateTime?
  revocationReason String?   @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshCredentials UserSessionRefreshCredential[]

  @@index([membershipId, status])
  @@index([familyId, status])
  @@index([status, expiresAt])
  @@index([status, absoluteExpiresAt])
  @@index([userId, status])
  @@index([tenantId, status])
  @@index([familyId, createdAt])
  @@index([status, lockedAt])
}

model UserSessionRefreshCredential {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  hash   String                  @unique @db.VarChar(64)
  status RefreshCredentialStatus @default(ACTIVE)

  issuedAt  DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?

  replacedById String?                       @unique @db.Uuid
  replacedBy   UserSessionRefreshCredential? @relation("CredentialRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     UserSessionRefreshCredential? @relation("CredentialRotation")

  rotationSequence Int @default(1)

  createdAt DateTime @default(now())

  @@index([sessionId, status])
  @@index([sessionId, issuedAt])
  @@index([status, issuedAt])
}

/// Task 0021: platform administration foundation.
///
/// A global AIM user MAY optionally have exactly one platform account.
/// Platform authority is derived only from this account + live role
/// assignments -- a tenant membership NEVER grants platform privileges and a
/// platform role NEVER grants tenant/clinical authority.
///
/// `userId` is `@unique`, proving "one platform account per global user".
model PlatformAccount {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation("PlatformAccountUser", fields: [userId], references: [id], onDelete: Restrict)

  status PlatformAccountStatus @default(ACTIVE)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roleAssignments PlatformRoleAssignment[]
  sessions        PlatformSession[]        @relation("PlatformAccountSessions")

  @@index([status])
  @@index([userId, status])
}

/// Task 0021: GLOBAL platform role. It has NO tenantId, is never a tenant
/// `Role`, and is seeded only by migration. Platform roles are immutable at
/// runtime (a database trigger rejects UPDATE/DELETE) so the protected owner
/// role can never be renamed, deleted, or silently replaced by an API call.
model PlatformRole {
  id   String @id @default(uuid()) @db.Uuid
  key  String @unique @db.VarChar(64)
  name String @db.VarChar(64)

  description String? @db.VarChar(240)
  /// CLT-owned roles (PLATFORM_OWNER, PLATFORM_ADMIN) can never be renamed,
  /// deleted, or have their permissions edited through HTTP APIs.
  isProtected Boolean @default(false)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions PlatformRolePermission[]
  roleAssignments PlatformRoleAssignment[]
  invitations     PlatformInvitation[]
}

/// Task 0021: platform role -> permission binding. Structurally separate from
/// the tenant `RolePermission` table (no tenantId, separate binding source),
/// so a tenant permission can never become platform authority merely because
/// both exist in the shared permission catalogue.
model PlatformRolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// Task 0021: live server-side platform role assignment binding the global
/// platform account to a global platform role. There is NO tenantId and NO
/// membershipId anywhere on this row -- a platform-role assignment can
/// never reference a tenant membership by construction.
///
/// `grantedRoleKey` is the denormalized copy of the granted PlatformRole.key,
/// validated by a database trigger at write time so the partial unique index
/// below can prove "at most one PLATFORM_OWNER assignment" in pure SQL.
model PlatformRoleAssignment {
  id String @id @default(uuid()) @db.Uuid

  platformAccountId String @db.Uuid
  roleId            String @db.Uuid
  grantedRoleKey    String @db.VarChar(64)

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  role            PlatformRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// The platform user who ordered this assignment. NULL only for the
  /// operator-invoked one-time initial-owner bootstrap.
  createdByPlatformUserId String? @db.Uuid
  createdByPlatformUser   User?   @relation("PlatformAssignmentCreatedBy", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([platformAccountId, roleId])
  @@index([roleId])
  @@index([platformAccountId])
}

/// Task 0021: invitation-only platform access. The plaintext invitation
/// secret is NEVER stored -- only the HMAC-SHA256 digest (`invitationHash`).
/// Invitations are single-use, expiring, revocable, bounded, and validated by
/// a cryptographic identity bound to the same normalized e-mail address.
model PlatformInvitation {
  id String @id @default(uuid()) @db.Uuid

  /// Normalized (trimmed, lower-cased) target global-identity e-mail.
  targetEmail String @db.Citext

  roleId String       @db.Uuid
  role   PlatformRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// HMAC-SHA256 hex digest of the invitation secret. Globally unique.
  invitationHash String @unique @db.VarChar(64)

  status PlatformInvitationStatus @default(PENDING)

  expiresAt DateTime

  acceptedAt       DateTime?
  acceptedByUserId String?   @db.Uuid
  acceptedByUser   User?     @relation("PlatformInvitationAccepted", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  revokedAt               DateTime?
  revokedByPlatformUserId String?   @db.Uuid
  revokedByPlatformUser   User?     @relation("PlatformInvitationRevokedBy", fields: [revokedByPlatformUserId], references: [id], onDelete: Restrict)

  createdByPlatformUserId String @db.Uuid
  createdByPlatformUser   User   @relation("PlatformInvitationCreatedBy", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, expiresAt])
  @@index([targetEmail, status])
  @@index([createdByPlatformUserId, createdAt])
  @@index([roleId])
}

/// Task 0021: dedicated, tenant-less platform session. Distinct from the
/// tenant-scoped `UserSession` (which keeps its invariants unchanged). A
/// platform session belongs to the exact global user + platform account
/// (proved by the FK to PlatformAccount.userId) and carries no tenant or
/// membership context at all.
model PlatformSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("PlatformSessionUser", fields: [userId], references: [id], onDelete: Cascade, map: "PlatformSession_userId_fkey")

  /// Session family for replay/compromise chain revocation, mirroring the
  /// accepted tenant-session architecture.
  familyId         String @db.Uuid
  refreshTokenHash String @unique @db.VarChar(64)

  ipAddress  String? @db.Inet
  userAgent  String? @db.VarChar(512)
  deviceName String? @db.VarChar(120)

  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime @default(now())

  status PlatformSessionStatus @default(ACTIVE)

  /// Mirrors Task 0014 workstation hardening: locked platform sessions fail
  /// closed and pre-lock platform access tokens are invalidated via
  /// securityVersion.
  lockedAt              DateTime?
  lockReason            String?   @db.VarChar(120)
  unlockedAt            DateTime?
  unlockMethod          String?   @db.VarChar(40)
  securityVersion       Int       @default(1)
  recentAuthenticatedAt DateTime?

  replacedById String?          @unique @db.Uuid
  replacedBy   PlatformSession? @relation("PlatformSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     PlatformSession? @relation("PlatformSessionRotation")

  version Int @default(1)

  revokedAt        DateTime?
  revocationReason String?   @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshCredentials PlatformSessionRefreshCredential[]

  platformAccount PlatformAccount @relation("PlatformAccountSessions", fields: [userId], references: [userId], onDelete: Cascade, map: "PlatformSession_platformAccount_userId_fkey")

  @@index([userId, status])
  @@index([familyId, status])
  @@index([status, expiresAt])
  @@index([status, absoluteExpiresAt])
  @@index([familyId, createdAt])
  @@index([status, lockedAt])
}

/// Task 0021: single-use platform refresh credentials. Same hashing, rotation
