generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  ROTATED
  EXPIRED
  REVOKED
  COMPROMISED
}

enum RefreshCredentialStatus {
  ACTIVE
  USED
  REVOKED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AuditActorType {
  TENANT_USER
  PLATFORM_USER
  SYSTEM
}

enum AuditScope {
  TENANT
  PLATFORM
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

enum ProviderType {
  PHARMACY
  HOSPITAL
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum ProductCategory {
  MEDICINE
  OTC
  COSMETIC
  AYURVEDIC
  SUPPLEMENT
  BABY_CARE
  PERSONAL_CARE
  MEDICAL_DEVICE
}

enum DosageForm {
  TABLET
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  CAPSULE
  DROPS
  INHALER
  SPRAY
  LOTION
  GEL
  POWDER
  SOLUTION
  SUSPENSION
}

enum RoleType {
  SYSTEM
  TENANT
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  QUARANTINED
}

enum BatchQuarantineReason {
  QUALITY_SUSPECT
  TEMPERATURE_EXCURSION
  PACKAGING_COMPROMISED
  STORAGE_DEVIATION
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  RETURN_IN
  RETURN_OUT
  EXPIRED
  DAMAGED
}

enum MedicineReservationStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

enum MedicineAllocationStatus {
  HELD
  CONSUMED
  RELEASED
}

enum MedicineReservationCommandType {
  CONFIRM
  READY
  COMPLETE
  CANCEL
  EXPIRE
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  FAILED
  DELIVERED
  DEAD_LETTER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationRecipientType {
  TENANT_MEMBERSHIP
  TENANT_OPERATIONAL_ROUTE
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  FAILED
  DELIVERED
  DEAD_LETTER
}

enum NotificationAttemptOutcome {
  DELIVERED
  FAILED
  DEAD_LETTER
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid

  name  String
  slug  String  @unique
  email String? @unique

  isActive                Boolean @default(true)
  selfRegistrationEnabled Boolean @default(false)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships                    TenantMembership[]
  sessions                       UserSession[]
  membershipProviderAccess       MembershipProviderAccess[]
  roles                          Role[]
  auditEvents                    AuditEvent[]
  providerVerifications          ProviderVerification[]
  providers                      Provider[]
  inventory                      Inventory[]
  batches                        Batch[]
  stockMovements                 StockMovement[]
  inventoryConfigurationCommands InventoryConfigurationCommand[]
  medicineReservations           MedicineReservation[]
  reservationItems               MedicineReservationItem[]
  reservationAllocations         MedicineReservationAllocation[]
  reservationCommands            MedicineReservationCommand[]
  inventoryTransfers             InventoryTransfer[]
  batchExpiryRecords             BatchExpiryRecord[]
  batchQuarantineRecords         BatchQuarantineRecord[]
  outboxEvents                   OutboxEvent[]
  eventInboxReceipts             EventInboxReceipt[]
  notificationDeliveries         NotificationDelivery[]
  notificationDeliveryAttempts   NotificationDeliveryAttempt[]

  @@index([slug])
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String @unique @db.Citext
  passwordHash String

  firstName String
  lastName  String

  phone String?

  preferredLanguage String @default("en")

  status UserStatus @default(ACTIVE)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships          TenantMembership[]
  sessions             UserSession[]
  platformAuditEvents  AuditEvent[]
  privacy              UserPrivacy?
  medicineReservations MedicineReservation[]
}

model TenantMembership {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status    MembershipStatus @default(PENDING)
  isDefault Boolean          @default(false)
  joinedAt  DateTime?
  endedAt   DateTime?

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions               UserSession[]
  roleAssignments        MembershipRole[]
  auditEvents            AuditEvent[]
  stockMovements         StockMovement[]
  providerAccess         MembershipProviderAccess[]
  batchQuarantineRecords BatchQuarantineRecord[]
  outboxEvents           OutboxEvent[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@unique([id, userId, tenantId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model UserPrivacy {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sharePhone                 Boolean @default(false)
  shareEmail                 Boolean @default(false)
  allowInAppChat             Boolean @default(true)
  privatePickup              Boolean @default(false)
  hideSensitiveNotifications Boolean @default(true)
  preferredLanguage          String  @default("en")

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name        String
  description String?

  type RoleType @default(TENANT)

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roleAssignments MembershipRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model Permission {
  id          String   @id @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String   @db.VarChar(240)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  role       Role             @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([membershipId, roleId])
  @@index([tenantId, membershipId])
  @@index([tenantId, roleId])
}

model MembershipProviderAccess {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  providerId   String @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade)
  provider   Provider         @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([membershipId, providerId])
  @@index([tenantId, membershipId])
  @@index([tenantId, providerId])
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([tenantId, roleId])
  @@index([permissionId])
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  membershipId String           @db.Uuid
  membership   TenantMembership @relation(fields: [membershipId, userId, tenantId], references: [id, userId, tenantId], onDelete: Cascade)

  familyId         String @db.Uuid
  refreshTokenHash String @unique @db.VarChar(64)

  ipAddress  String? @db.Inet
  userAgent  String? @db.VarChar(512)
  deviceName String? @db.VarChar(120)

  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime @default(now())

  status SessionStatus @default(ACTIVE)

  replacedById String?      @unique @db.Uuid
  replacedBy   UserSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     UserSession? @relation("SessionRotation")

  version Int @default(1)

  revokedAt        DateTime?
  revocationReason String?   @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshCredentials UserSessionRefreshCredential[]

  @@index([membershipId, status])
  @@index([familyId, status])
  @@index([status, expiresAt])
  @@index([status, absoluteExpiresAt])
  @@index([userId, status])
  @@index([tenantId, status])
  @@index([familyId, createdAt])
}

model UserSessionRefreshCredential {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  hash   String                  @unique @db.VarChar(64)
  status RefreshCredentialStatus @default(ACTIVE)

  issuedAt  DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?

  replacedById String?                       @unique @db.Uuid
  replacedBy   UserSessionRefreshCredential? @relation("CredentialRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     UserSessionRefreshCredential? @relation("CredentialRotation")

  rotationSequence Int @default(1)

  createdAt DateTime @default(now())

  @@index([sessionId, status])
  @@index([sessionId, issuedAt])
  @@index([status, issuedAt])
}

model ProviderVerification {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType ProviderType
  status       VerificationStatus @default(PENDING)

  licenseNumber              String
  licenseExpiryDate          DateTime
  businessRegistrationNumber String
  governmentIdReference      String

  verificationNotes String?
  submittedAt       DateTime  @default(now())
  verifiedAt        DateTime?
  verifiedBy        String?   @db.Uuid

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([providerType])
}

model Provider {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType ProviderType
  businessName String
  ownerName    String
  email        String
  phone        String
  address      String
  city         String
  state        String
  country      String
  postalCode   String
  latitude     Float
  longitude    Float
  geoHash      String?

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  inventory                     Inventory[]
  batches                       Batch[]
  stockMovements                StockMovement[]
  medicineReservations          MedicineReservation[]
  reservationItems              MedicineReservationItem[]
  reservationAllocations        MedicineReservationAllocation[]
  membershipAccesses            MembershipProviderAccess[]
  sourceInventoryTransfers      InventoryTransfer[]             @relation("InventoryTransferSourceProvider")
  destinationInventoryTransfers InventoryTransfer[]             @relation("InventoryTransferDestinationProvider")
  batchExpiryRecords            BatchExpiryRecord[]
  batchQuarantineRecords        BatchQuarantineRecord[]

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([providerType])
  @@index([email])
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  name                 String
  genericName          String?
  brand                String
  category             ProductCategory
  subCategory          String?
  description          String?
  manufacturer         String
  dosageForm           DosageForm
  strength             String
  barcode              String?
  requiresPrescription Boolean         @default(false)

  isActive               Boolean                         @default(true)
  inventory              Inventory[]
  batches                Batch[]
  stockMovements         StockMovement[]
  reservationItems       MedicineReservationItem[]
  reservationAllocations MedicineReservationAllocation[]
  inventoryTransfers     InventoryTransfer[]
  batchExpiryRecords     BatchExpiryRecord[]
  batchQuarantineRecords BatchQuarantineRecord[]

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([name])
  @@index([barcode])
}

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  sku                String? @db.VarChar(120)
  sellingPrice       Decimal @db.Decimal(10, 2)
  mrp                Decimal @db.Decimal(10, 2)
  discountPercentage Decimal @db.Decimal(5, 2)
  taxPercentage      Decimal @db.Decimal(5, 2)
  minimumStockLevel  Int     @default(10)
  isVisible          Boolean @default(true)
  version            Int     @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  batches                Batch[]
  stockMovements         StockMovement[]
  configurationCommands  InventoryConfigurationCommand[]
  reservationAllocations MedicineReservationAllocation[]
  sourceTransfers        InventoryTransfer[]             @relation("InventoryTransferSourceInventory")
  destinationTransfers   InventoryTransfer[]             @relation("InventoryTransferDestinationInventory")
  batchExpiryRecords     BatchExpiryRecord[]
  batchQuarantineRecords BatchQuarantineRecord[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, providerId, productId])
  @@unique([tenantId, providerId, productId])
  @@index([tenantId, providerId, productId])
  @@index([productId])
  @@index([tenantId, providerId, isVisible])
}

model InventoryConfigurationCommand {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId, tenantId], references: [id, tenantId], onDelete: Restrict)

  idempotencyKey    String   @db.VarChar(120)
  configurationHash String   @db.VarChar(64)
  resultingVersion  Int
  createdAt         DateTime @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, inventoryId, createdAt(sort: Desc)])
}

model Batch {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId, tenantId, providerId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict)

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  batchNumber       String      @db.VarChar(120)
  manufacturingDate DateTime?
  expiryDate        DateTime
  receivedQuantity  Int
  onHandQuantity    Int
  heldQuantity      Int         @default(0)
  purchasePrice     Decimal     @db.Decimal(10, 2)
  sellingPrice      Decimal     @db.Decimal(10, 2)
  status            BatchStatus @default(ACTIVE)
  version           Int         @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stockMovements         StockMovement[]
  reservationAllocations MedicineReservationAllocation[]
  sourceTransfers        InventoryTransfer[]             @relation("InventoryTransferSourceBatch")
  destinationTransfers   InventoryTransfer[]             @relation("InventoryTransferDestinationBatch")
  expiryRecord           BatchExpiryRecord?
  quarantineRecord       BatchQuarantineRecord?

  @@unique([tenantId, providerId, productId, batchNumber])
  @@unique([id, tenantId, inventoryId, providerId, productId])
  @@unique([id, tenantId, inventoryId, providerId, productId, expiryDate], map: "Batch_id_tenantId_inventoryId_providerId_product_expiry_key")
  @@index([tenantId, providerId, productId, status, expiryDate, manufacturingDate, createdAt, id])
  @@index([inventoryId, status, expiryDate])
}

model BatchExpiryRecord {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "BatchExpiryRecord_tenantId_fkey")

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId, tenantId, providerId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict, map: "BatchExpiryRecord_inventory_scope_fkey")

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "BatchExpiryRecord_provider_scope_fkey")

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, map: "BatchExpiryRecord_productId_fkey")

  batchId String @unique(map: "BatchExpiryRecord_batchId_key") @db.Uuid
  batch   Batch  @relation(fields: [batchId, tenantId, inventoryId, providerId, productId, expiryDate], references: [id, tenantId, inventoryId, providerId, productId, expiryDate], onDelete: Restrict, map: "BatchExpiryRecord_batch_scope_fkey")

  expiryDate            DateTime
  onHandQuantity        Int
  resultingBatchVersion Int
  reconciledAt          DateTime
  createdAt             DateTime @default(now())

  @@unique([batchId, tenantId, inventoryId, providerId, productId, expiryDate], map: "BatchExpiryRecord_batchId_tenantId_inventoryId_provider_key")
  @@index([tenantId, reconciledAt(sort: Desc), id(sort: Desc)], map: "BatchExpiryRecord_tenantId_reconciledAt_id_idx")
  @@index([tenantId, providerId, productId, reconciledAt(sort: Desc)], map: "BatchExpiryRecord_tenantId_providerId_productId_reconcil_idx")
}

model BatchQuarantineRecord {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "BatchQuarantineRecord_tenantId_fkey")

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId, tenantId, providerId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict, map: "BatchQuarantineRecord_inventory_scope_fkey")

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "BatchQuarantineRecord_provider_scope_fkey")

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, map: "BatchQuarantineRecord_productId_fkey")

  batchId String @unique(map: "BatchQuarantineRecord_batchId_key") @db.Uuid
  batch   Batch  @relation(fields: [batchId, tenantId, inventoryId, providerId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict, map: "BatchQuarantineRecord_batch_scope_fkey")

  actorMembershipId String           @db.Uuid
  actorMembership   TenantMembership @relation(fields: [actorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "BatchQuarantineRecord_actor_scope_fkey")

  reasonCode               BatchQuarantineReason
  onHandQuantity           Int
  affectedReservationCount Int
  releasedUnitCount        Int
  idempotencyKey           String                @db.VarChar(120)
  commandHash              String                @db.VarChar(64)
  resultingBatchVersion    Int
  occurredAt               DateTime
  createdAt                DateTime              @default(now())

  @@unique([tenantId, idempotencyKey], map: "BatchQuarantineRecord_tenantId_idempotencyKey_key")
  @@unique([batchId, tenantId, inventoryId, providerId, productId], map: "BatchQuarantineRecord_batch_scope_key")
  @@index([tenantId, providerId, occurredAt(sort: Desc), id(sort: Desc)], map: "BatchQuarantineRecord_tenant_provider_occurred_idx")
  @@index([actorMembershipId, occurredAt(sort: Desc), id(sort: Desc)], map: "BatchQuarantineRecord_actor_occurred_idx")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId, tenantId, providerId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict)

  batchId String @db.Uuid
  batch   Batch  @relation(fields: [batchId, tenantId, inventoryId, providerId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict)

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  type         StockMovementType
  delta        Int
  onHandBefore Int
  onHandAfter  Int

  referenceType         String? @db.VarChar(80)
  referenceId           String? @db.VarChar(120)
  reason                String? @db.VarChar(500)
  idempotencyKey        String  @db.VarChar(120)
  commandHash           String? @db.VarChar(64)
  resultingBatchVersion Int?

  actorType         AuditActorType
  actorMembershipId String?           @db.Uuid
  actorMembership   TenantMembership? @relation(fields: [actorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  sourceTransfers      InventoryTransfer[] @relation("InventoryTransferSourceMovement")
  destinationTransfers InventoryTransfer[] @relation("InventoryTransferDestinationMovement")

  @@unique([tenantId, idempotencyKey])
  @@unique([id, tenantId, inventoryId, batchId, providerId, productId])
  @@index([tenantId, inventoryId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, batchId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, providerId, productId, occurredAt(sort: Desc)])
  @@index([actorMembershipId, occurredAt(sort: Desc)])
}

model InventoryTransfer {
  id                      String        @id @default(uuid()) @db.Uuid
  tenantId                String        @db.Uuid
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceProviderId        String        @db.Uuid
  sourceProvider          Provider      @relation("InventoryTransferSourceProvider", fields: [sourceProviderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  destinationProviderId   String        @db.Uuid
  destinationProvider     Provider      @relation("InventoryTransferDestinationProvider", fields: [destinationProviderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  productId               String        @db.Uuid
  product                 Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceInventoryId       String        @db.Uuid
  sourceInventory         Inventory     @relation("InventoryTransferSourceInventory", fields: [sourceInventoryId, tenantId, sourceProviderId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict)
  destinationInventoryId  String        @db.Uuid
  destinationInventory    Inventory     @relation("InventoryTransferDestinationInventory", fields: [destinationInventoryId, tenantId, destinationProviderId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict)
  sourceBatchId           String        @db.Uuid
  sourceBatch             Batch         @relation("InventoryTransferSourceBatch", fields: [sourceBatchId, tenantId, sourceInventoryId, sourceProviderId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict)
  destinationBatchId      String        @db.Uuid
  destinationBatch        Batch         @relation("InventoryTransferDestinationBatch", fields: [destinationBatchId, tenantId, destinationInventoryId, destinationProviderId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict)
  quantity                Int
  idempotencyKey          String        @db.VarChar(120)
  commandHash             String        @db.VarChar(64)
  sourceOnHandAfter       Int
  destinationOnHandAfter  Int
  sourceBatchVersion      Int
  destinationBatchVersion Int
  sourceMovementId        String        @db.Uuid
  sourceMovement          StockMovement @relation("InventoryTransferSourceMovement", fields: [sourceMovementId, tenantId, sourceInventoryId, sourceBatchId, sourceProviderId, productId], references: [id, tenantId, inventoryId, batchId, providerId, productId], onDelete: Restrict)
  destinationMovementId   String        @db.Uuid
  destinationMovement     StockMovement @relation("InventoryTransferDestinationMovement", fields: [destinationMovementId, tenantId, destinationInventoryId, destinationBatchId, destinationProviderId, productId], references: [id, tenantId, inventoryId, batchId, providerId, productId], onDelete: Restrict)
  completedAt             DateTime      @default(now())
  createdAt               DateTime      @default(now())

  @@unique([tenantId, idempotencyKey])
  @@unique([sourceMovementId])
  @@unique([destinationMovementId])
  @@index([tenantId, sourceProviderId, completedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, destinationProviderId, completedAt(sort: Desc), id(sort: Desc)])
}

model AuditEvent {
  id                  String         @id @default(uuid()) @db.Uuid
  scope               AuditScope
  actorType           AuditActorType
  outcome             AuditOutcome
  tenantId            String?        @db.Uuid
  actorMembershipId   String?        @db.Uuid
  platformActorUserId String?        @db.Uuid
  eventType           String         @db.VarChar(120)
  resourceType        String?        @db.VarChar(80)
  resourceId          String?        @db.VarChar(120)
  requestId           String?        @db.VarChar(120)
  ipAddress           String?        @db.Inet
  userAgent           String?        @db.VarChar(512)
  metadata            Json
  occurredAt          DateTime       @default(now())

  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorMembership   TenantMembership? @relation(fields: [actorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  platformActorUser User?             @relation(fields: [platformActorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, eventType, occurredAt(sort: Desc)])
  @@index([actorMembershipId, occurredAt(sort: Desc)])
  @@index([platformActorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
}

model OutboxEvent {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType         String            @db.VarChar(120)
  eventVersion      Int               @default(1)
  aggregateType     String            @db.VarChar(80)
  aggregateId       String            @db.VarChar(120)
  actorType         AuditActorType
  actorMembershipId String?           @db.Uuid
  actorUserId       String?           @db.Uuid
  actorMembership   TenantMembership? @relation(fields: [actorMembershipId, actorUserId, tenantId], references: [id, userId, tenantId], onDelete: Restrict)
  systemService     String?           @db.VarChar(80)
  correlationId     String?           @db.VarChar(120)
  causationId       String?           @db.VarChar(120)
  payload           Json
  occurredAt        DateTime
  status            OutboxEventStatus @default(PENDING)
  attemptCount      Int               @default(0)
  availableAt       DateTime          @default(now())
  lockedAt          DateTime?
  lockedUntil       DateTime?
  lockToken         String?           @db.VarChar(64)
  deliveredAt       DateTime?
  lastErrorCode     String?           @db.VarChar(80)
  createdAt         DateTime          @default(now())

  inboxReceipts          EventInboxReceipt[]
  notificationDeliveries NotificationDelivery[]

  @@unique([id, tenantId])
  @@index([status, availableAt, occurredAt, id])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, eventType, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([actorMembershipId, occurredAt(sort: Desc)])
}

model EventInboxReceipt {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  consumerName String      @db.VarChar(80)
  eventId      String      @db.Uuid
  event        OutboxEvent @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  processedAt  DateTime    @default(now())

  @@unique([consumerName, eventId])
  @@index([tenantId, processedAt(sort: Desc), id(sort: Desc)])
}

model NotificationDelivery {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @db.Uuid
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceEventId        String                     @db.Uuid
  sourceEvent          OutboxEvent                @relation(fields: [sourceEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  workflowKey          String                     @db.VarChar(80)
  recipientType        NotificationRecipientType
  recipientReferenceId String                     @db.VarChar(120)
  channel              NotificationChannel
  templateKey          String                     @db.VarChar(120)
  templateVersion      Int                        @default(1)
  variables            Json
  status               NotificationDeliveryStatus @default(PENDING)
  attemptCount         Int                        @default(0)
  availableAt          DateTime                   @default(now())
  lockedAt             DateTime?
  lockedUntil          DateTime?
  lockToken            String?                    @db.VarChar(64)
  deliveredAt          DateTime?
  lastErrorCode        String?                    @db.VarChar(80)
  createdAt            DateTime                   @default(now())

  attempts NotificationDeliveryAttempt[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceEventId, workflowKey, recipientType, recipientReferenceId, channel])
  @@index([status, availableAt, createdAt, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, recipientType, recipientReferenceId, createdAt(sort: Desc)])
}

model NotificationDeliveryAttempt {
  id                    String                     @id @default(uuid()) @db.Uuid
  tenantId              String                     @db.Uuid
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveryId            String                     @db.Uuid
  delivery              NotificationDelivery       @relation(fields: [deliveryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  attemptNumber         Int
  outcome               NotificationAttemptOutcome
  providerKey           String                     @db.VarChar(80)
  errorCode             String?                    @db.VarChar(80)
  providerReferenceHash String?                    @db.VarChar(64)
  occurredAt            DateTime
  createdAt             DateTime                   @default(now())

  @@unique([deliveryId, attemptNumber])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, outcome, occurredAt(sort: Desc)])
}

enum MedicalRecordType {
  PRESCRIPTION
  LAB_REPORT
  XRAY
  MRI
  CT_SCAN
  VACCINATION
  DISCHARGE_SUMMARY
  INSURANCE
  OTHER
}

model MedicalRecord {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  recordType  MedicalRecordType
  title       String
  description String?

  fileUrl  String
  fileName String
  fileSize Int
  mimeType String

  recordDate DateTime
  uploadedAt DateTime @default(now())

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([recordType])
}

model MedicineReservation {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  subjectUserId String @db.Uuid
  subjectUser   User   @relation(fields: [subjectUserId], references: [id], onDelete: Restrict)

  status         MedicineReservationStatus @default(PENDING)
  expiresAt      DateTime
  confirmedAt    DateTime?
  readyAt        DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  expiredAt      DateTime?
  notes          String?                   @db.VarChar(500)
  idempotencyKey String                    @db.VarChar(120)
  creationHash   String                    @db.VarChar(64)
  version        Int                       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       MedicineReservationItem[]
  allocations MedicineReservationAllocation[]
  commands    MedicineReservationCommand[]

  @@unique([tenantId, idempotencyKey])
  @@unique([id, tenantId, providerId])
  @@index([tenantId, providerId, status, expiresAt, id])
  @@index([subjectUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, expiresAt, id])
}

model MedicineReservationCommand {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reservationId String              @db.Uuid
  reservation   MedicineReservation @relation(fields: [reservationId, tenantId, providerId], references: [id, tenantId, providerId], onDelete: Restrict)

  providerId String @db.Uuid

  commandType      MedicineReservationCommandType
  idempotencyKey   String                         @db.VarChar(120)
  commandHash      String                         @db.VarChar(64)
  resultingStatus  MedicineReservationStatus
  resultingVersion Int
  createdAt        DateTime                       @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, reservationId, createdAt(sort: Desc)])
}

model MedicineReservationItem {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reservationId String              @db.Uuid
  reservation   MedicineReservation @relation(fields: [reservationId, tenantId, providerId], references: [id, tenantId, providerId], onDelete: Restrict)

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity  Int
  createdAt DateTime @default(now())

  allocations MedicineReservationAllocation[]

  @@unique([reservationId, productId])
  @@unique([id, tenantId, reservationId, providerId, productId])
  @@index([tenantId, providerId, productId])
}

model MedicineReservationAllocation {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reservationId String              @db.Uuid
  reservation   MedicineReservation @relation(fields: [reservationId, tenantId, providerId], references: [id, tenantId, providerId], onDelete: Restrict)

  itemId String                  @db.Uuid
  item   MedicineReservationItem @relation(fields: [itemId, tenantId, reservationId, providerId, productId], references: [id, tenantId, reservationId, providerId, productId], onDelete: Restrict)

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId, tenantId, providerId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict)

  batchId String @db.Uuid
  batch   Batch  @relation(fields: [batchId, tenantId, inventoryId, providerId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict)

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity   Int
  status     MedicineAllocationStatus @default(HELD)
  consumedAt DateTime?
  releasedAt DateTime?
  createdAt  DateTime                 @default(now())

  @@unique([itemId, batchId])
  @@index([tenantId, reservationId, status])
  @@index([tenantId, batchId, status])
}
