/// Task 0025: append-only physical-stock observation evidence. One row records
/// one qualifying event where a trusted inventory command objectively established
/// the physical quantity of a batch (batch receipt, physical stock adjustment,
/// completed transfer endpoint, damaged-stock write-off). Future evidence sources
/// (manual physical counts, POS synchronization, live pharmacist confirmation)
/// append rows through the same table without redesigning the freshness/trust model.
///
/// `occurredAt` is the observation's own occurrence timestamp. For AIM-managed
/// commands it is derived from the same database transaction clock that stamps the
/// driving StockMovement. Current evidence for a batch is always the row with the
/// newest `occurredAt`; older or equal evidence arriving later is ignored, so delayed
/// or out-of-order writes can never overwrite newer evidence. Idempotent retries of
/// the driving command deterministically reuse the same observation key, making
/// duplicates no-ops.
///
/// `observedOnHandQuantity` is the newly established physical quantity at the time
/// of the observation. It is bound to the accepted Batch quantity authority (the row
/// is written atomically with the command that mutated Batch) and never introduces a
/// second quantity authority. Reservation-held quantity continues reducing the
/// trusted available quantity exclusively through the accepted reservation model.
model BatchStockObservation {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "BatchStockObservation_tenantId_fkey")

  inventoryId String    @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId, tenantId, providerId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict, map: "BatchStockObservation_inventory_scope_fkey")

  batchId String @db.Uuid
  batch   Batch  @relation(fields: [batchId, tenantId, inventoryId, providerId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict, map: "BatchStockObservation_batch_scope_fkey")

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "BatchStockObservation_provider_scope_fkey")

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, map: "BatchStockObservation_productId_fkey")

  source                 AvailabilityEvidenceSource
  observedOnHandQuantity Int
  occurredAt             DateTime

  /// Provenance back-reference to the accepted StockMovement that drove this
  /// observation. Null for future sources that produce no movement (e.g. manual
  /// physical count or POS sync).
  movementId String?        @db.Uuid
  movement   StockMovement? @relation("BatchStockObservationMovement", fields: [movementId, tenantId, inventoryId, batchId, providerId, productId], references: [id, tenantId, inventoryId, batchId, providerId, productId], onDelete: Restrict, map: "BatchStockObservation_movement_scope_fkey")

  /// Deterministic command anchor: the same command retried against the same
  /// batch reproduces the same key, making a re-insertion a no-op. Matches the
  /// repository-wide idempotency-key convention (VARCHAR(120)).
  idempotencyKey String @db.VarChar(120)

  createdAt DateTime @default(now())

  @@unique([tenantId, idempotencyKey], map: "BatchStockObservation_tenantId_idempotencyKey_key")
  @@unique([batchId, occurredAt, source], map: "BatchStockObservation_batchId_occurredAt_source_key")
  @@index([batchId, occurredAt(sort: Desc), id(sort: Desc)], map: "BatchStockObservation_batch_occurredAt_idx")
  @@index([tenantId, providerId, productId, occurredAt(sort: Desc), id(sort: Desc)], map: "BatchStockObservation_tenant_provider_product_occurredAt_idx")
  @@index([tenantId, inventoryId, occurredAt(sort: Desc), id(sort: Desc)], map: "BatchStockObservation_tenant_inventory_occurredAt_idx")
}

/// Task 0026: provider/product live availability request.
///
/// A request is exactly one server-derived tenant + one verified/active
/// provider + one active product and carries NO patient medical data (no
/// patient name, contact info, prescription, diagnosis, symptoms, health
/// condition, or free-form patient text). It is simply "please confirm
/// whether this provider currently has this product available".
///
/// `activeDedupKey` is a deterministic derived key (`providerId:productId`)
/// that is set while a request is PENDING and cleared (NULL) once it is
/// RESPONDED or EXPIRED. Its unique constraint gives the database the
/// authority to guarantee at most one effective PENDING request per
/// tenant/provider/product, so concurrent public request creation converges
/// on one request instead of producing operational spam. Prisma cannot
/// express partial unique indexes, so this nullable-unique derived column is
/// the schema-visible form of the same invariant.
model AvailabilityRequest {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "AvailabilityRequest_tenantId_fkey")

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "AvailabilityRequest_provider_scope_fkey")

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, map: "AvailabilityRequest_productId_fkey")

  status AvailabilityRequestStatus @default(PENDING)

  /// Derived `providerId:productId` while PENDING, NULL once resolved. See the
  /// model doc for the concurrency/deduplication invariant this provides.
  activeDedupKey String? @unique @db.VarChar(80)

  requestedAt DateTime
  expiresAt   DateTime
  respondedAt DateTime?

  /// Optimistic-concurrency version: incremented on every transition so a
  /// stale concurrent responder can never win twice.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confirmationEvidence ProviderProductAvailabilityEvidence[]

  @@unique([id, tenantId], map: "AvailabilityRequest_id_tenantId_key")
  @@unique([id, tenantId, providerId, productId], map: "AvailabilityRequest_id_tenant_provider_product_key")
  @@index([tenantId, providerId, productId, status], map: "AvailabilityRequest_tenant_provider_product_status_idx")
  @@index([tenantId, providerId, status, requestedAt, id], map: "AvailabilityRequest_tenant_provider_status_requested_idx")
  @@index([tenantId, status, expiresAt], map: "AvailabilityRequest_tenant_status_expiresAt_idx")
}

/// Task 0026: append-only provider/product-level temporary evidence.
///
/// A pharmacist answering one availability request appends one row here. The
/// row is provider/product-scoped (NOT batch-scoped), is never a Batch
/// quantity, never changes Batch on-hand/held quantities, and never creates a
/// StockMovement. Evidence is immutable: a correction appends newer evidence
/// rather than rewriting history (enforced by a database trigger).
///
/// Validity is bounded and server-derived: AVAILABLE/UNAVAILABLE rows carry a
/// `validUntil` (default 30 minutes); CHECK_LATER rows carry a bounded
/// `retryAfterAt` and never claim current availability. Expired evidence must
/// never continue to produce a current confirmation.
model ProviderProductAvailabilityEvidence {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, map: "ProviderProductAvailabilityEvidence_tenantId_fkey")

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "ProviderProductAvailabilityEvidence_provider_scope_fkey")

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, map: "ProviderProductAvailabilityEvidence_productId_fkey")

  availabilityRequestId String              @db.Uuid
  availabilityRequest   AvailabilityRequest @relation(fields: [availabilityRequestId, tenantId, providerId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict, map: "ProviderProductAvailabilityEvidence_request_scope_fkey")

  source  ProviderProductAvailabilityEvidenceSource
  outcome PharmacistConfirmationOutcome

  /// Server/database time of the confirmation, never client-supplied.
  confirmedAt DateTime

  /// AVAILABLE/UNAVAILABLE only: moment this live confirmation stops counting
  /// as current. Server-derived from the accepted bounded policy.
  validUntil DateTime?

  /// CHECK_LATER only: bounded retry time after which the patient may ask
  /// again. Server-derived from the accepted bounded retryAfterMinutes input.
  retryAfterAt DateTime?

  /// Task 0019 exact-user accountability: responder identity is always
  /// derived from the authenticated session/membership chain, never from the
  /// request body.
  responderMembershipId String           @db.Uuid
  responderMembership   TenantMembership @relation(fields: [responderMembershipId, responderUserId, tenantId], references: [id, userId, tenantId], onDelete: Restrict, map: "ProviderProductAvailabilityEvidence_responder_scope_fkey")
  responderUserId       String           @db.Uuid
  responderUser         User             @relation(fields: [responderUserId], references: [id], onDelete: Restrict, map: "ProviderProductAvailabilityEvidence_responderUserId_fkey")

  /// Deterministic replay anchor: the same response retried with the same key
  /// and content is a safe no-op; reuse with different content conflicts.
  idempotencyKey String @db.VarChar(120)
  commandHash    String @db.VarChar(64)

  createdAt DateTime @default(now())

  @@unique([tenantId, idempotencyKey], map: "ProviderProductAvailabilityEvidence_tenantId_idempotencyKey_key")
  @@index([tenantId, providerId, productId, createdAt(sort: Desc), id(sort: Desc)], map: "ProviderProductEvidence_tenant_provider_product_created_idx")
  @@index([availabilityRequestId], map: "ProviderProductEvidence_requestId_idx")
  @@index([tenantId, validUntil, createdAt], map: "ProviderProductEvidence_tenant_validUntil_idx")
  @@index([tenantId, retryAfterAt, createdAt], map: "ProviderProductEvidence_tenant_retryAfter_idx")
  @@index([responderMembershipId, createdAt(sort: Desc)], map: "ProviderProductEvidence_responder_created_idx")
}

model InventoryTransfer {
  id                      String        @id @default(uuid()) @db.Uuid
  tenantId                String        @db.Uuid
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceProviderId        String        @db.Uuid
  sourceProvider          Provider      @relation("InventoryTransferSourceProvider", fields: [sourceProviderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  destinationProviderId   String        @db.Uuid
  destinationProvider     Provider      @relation("InventoryTransferDestinationProvider", fields: [destinationProviderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  productId               String        @db.Uuid
  product                 Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceInventoryId       String        @db.Uuid
  sourceInventory         Inventory     @relation("InventoryTransferSourceInventory", fields: [sourceInventoryId, tenantId, sourceProviderId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict)
  destinationInventoryId  String        @db.Uuid
  destinationInventory    Inventory     @relation("InventoryTransferDestinationInventory", fields: [destinationInventoryId, tenantId, destinationProviderId, productId], references: [id, tenantId, providerId, productId], onDelete: Restrict)
  sourceBatchId           String        @db.Uuid
  sourceBatch             Batch         @relation("InventoryTransferSourceBatch", fields: [sourceBatchId, tenantId, sourceInventoryId, sourceProviderId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict)
  destinationBatchId      String        @db.Uuid
  destinationBatch        Batch         @relation("InventoryTransferDestinationBatch", fields: [destinationBatchId, tenantId, destinationInventoryId, destinationProviderId, productId], references: [id, tenantId, inventoryId, providerId, productId], onDelete: Restrict)
  quantity                Int
  idempotencyKey          String        @db.VarChar(120)
  commandHash             String        @db.VarChar(64)
  sourceOnHandAfter       Int
  destinationOnHandAfter  Int
  sourceBatchVersion      Int
  destinationBatchVersion Int
  sourceMovementId        String        @db.Uuid
  sourceMovement          StockMovement @relation("InventoryTransferSourceMovement", fields: [sourceMovementId, tenantId, sourceInventoryId, sourceBatchId, sourceProviderId, productId], references: [id, tenantId, inventoryId, batchId, providerId, productId], onDelete: Restrict)
  destinationMovementId   String        @db.Uuid
  destinationMovement     StockMovement @relation("InventoryTransferDestinationMovement", fields: [destinationMovementId, tenantId, destinationInventoryId, destinationBatchId, destinationProviderId, productId], references: [id, tenantId, inventoryId, batchId, providerId, productId], onDelete: Restrict)
  completedAt             DateTime      @default(now())
  createdAt               DateTime      @default(now())

  @@unique([tenantId, idempotencyKey])
  @@unique([sourceMovementId])
  @@unique([destinationMovementId])
  @@index([tenantId, sourceProviderId, completedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, destinationProviderId, completedAt(sort: Desc), id(sort: Desc)])
}

model AuditEvent {
  id                  String         @id @default(uuid()) @db.Uuid
  scope               AuditScope
  actorType           AuditActorType
  outcome             AuditOutcome
  tenantId            String?        @db.Uuid
  actorMembershipId   String?        @db.Uuid
  /// Task 0019: immutable exact-user attribution for TENANT_USER events.
  /// The composite FK (actorMembershipId, actorUserId, tenantId) proves the
  /// membership-user-tenant triple at write time and prevents cross-tenant
  /// spoofing or pairing an arbitrary user with another user's membership.
  /// This remains attributable after membership suspension/revocation because
  /// the FK is RESTRICT and membership rows are never deleted.
  actorUserId         String?        @db.Uuid
  platformActorUserId String?        @db.Uuid
  eventType           String         @db.VarChar(120)
  resourceType        String?        @db.VarChar(80)
  resourceId          String?        @db.VarChar(120)
  requestId           String?        @db.VarChar(120)
  ipAddress           String?        @db.Inet
  userAgent           String?        @db.VarChar(512)
  metadata            Json
  occurredAt          DateTime       @default(now())

  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorMembership   TenantMembership? @relation(fields: [actorMembershipId, actorUserId, tenantId], references: [id, userId, tenantId], onDelete: Restrict)
  actorUser         User?             @relation("AuditEventActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  platformActorUser User?             @relation("AuditEventPlatformActor", fields: [platformActorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, eventType, occurredAt(sort: Desc)])
  @@index([actorMembershipId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([platformActorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
}

model OutboxEvent {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType         String            @db.VarChar(120)
  eventVersion      Int               @default(1)
  aggregateType     String            @db.VarChar(80)
  aggregateId       String            @db.VarChar(120)
  actorType         AuditActorType
  actorMembershipId String?           @db.Uuid
  actorUserId       String?           @db.Uuid
  actorMembership   TenantMembership? @relation(fields: [actorMembershipId, actorUserId, tenantId], references: [id, userId, tenantId], onDelete: Restrict)
  systemService     String?           @db.VarChar(80)
  correlationId     String?           @db.VarChar(120)
  causationId       String?           @db.VarChar(120)
  payload           Json
  occurredAt        DateTime
  status            OutboxEventStatus @default(PENDING)
  attemptCount      Int               @default(0)
  availableAt       DateTime          @default(now())
  lockedAt          DateTime?
  lockedUntil       DateTime?
  lockToken         String?           @db.VarChar(64)
  deliveredAt       DateTime?
  lastErrorCode     String?           @db.VarChar(80)
  createdAt         DateTime          @default(now())

  inboxReceipts          EventInboxReceipt[]
  notificationDeliveries NotificationDelivery[]

  @@unique([id, tenantId])
  @@index([status, availableAt, occurredAt, id])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, eventType, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([actorMembershipId, occurredAt(sort: Desc)])
}

model EventInboxReceipt {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  consumerName String      @db.VarChar(80)
  eventId      String      @db.Uuid
  event        OutboxEvent @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  processedAt  DateTime    @default(now())

  @@unique([consumerName, eventId])
  @@index([tenantId, processedAt(sort: Desc), id(sort: Desc)])
}

model NotificationDelivery {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @db.Uuid
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceEventId        String                     @db.Uuid
  sourceEvent          OutboxEvent                @relation(fields: [sourceEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  workflowKey          String                     @db.VarChar(80)
  recipientType        NotificationRecipientType
  recipientReferenceId String                     @db.VarChar(120)
  channel              NotificationChannel
  templateKey          String                     @db.VarChar(120)
  templateVersion      Int                        @default(1)
  variables            Json
  status               NotificationDeliveryStatus @default(PENDING)
  attemptCount         Int                        @default(0)
  availableAt          DateTime                   @default(now())
  lockedAt             DateTime?
  lockedUntil          DateTime?
  lockToken            String?                    @db.VarChar(64)
  deliveredAt          DateTime?
  lastErrorCode        String?                    @db.VarChar(80)
  createdAt            DateTime                   @default(now())

  attempts NotificationDeliveryAttempt[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceEventId, workflowKey, recipientType, recipientReferenceId, channel])
  @@index([status, availableAt, createdAt, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, recipientType, recipientReferenceId, createdAt(sort: Desc)])
}

model NotificationDeliveryAttempt {
  id                    String                     @id @default(uuid()) @db.Uuid
  tenantId              String                     @db.Uuid
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveryId            String                     @db.Uuid
  delivery              NotificationDelivery       @relation(fields: [deliveryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  attemptNumber         Int
  outcome               NotificationAttemptOutcome
  providerKey           String                     @db.VarChar(80)
  errorCode             String?                    @db.VarChar(80)
  providerReferenceHash String?                    @db.VarChar(64)
  occurredAt            DateTime
  createdAt             DateTime                   @default(now())

  @@unique([deliveryId, attemptNumber])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, outcome, occurredAt(sort: Desc)])
}

enum MedicalRecordType {
  PRESCRIPTION
  LAB_REPORT
  XRAY
  MRI
  CT_SCAN
  VACCINATION
  DISCHARGE_SUMMARY
  INSURANCE
  OTHER
}

model MedicalRecord {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  recordType  MedicalRecordType
  title       String
  description String?

  fileUrl  String
  fileName String
  fileSize Int
  mimeType String

  recordDate DateTime
  uploadedAt DateTime @default(now())

  version Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([recordType])
}

model MedicineReservation {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  subjectUserId String @db.Uuid
  subjectUser   User   @relation(fields: [subjectUserId], references: [id], onDelete: Restrict)

  status         MedicineReservationStatus @default(PENDING)
  expiresAt      DateTime
  confirmedAt    DateTime?
  readyAt        DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  expiredAt      DateTime?
  notes          String?                   @db.VarChar(500)
  idempotencyKey String                    @db.VarChar(120)
  creationHash   String                    @db.VarChar(64)
  version        Int                       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       MedicineReservationItem[]
  allocations MedicineReservationAllocation[]
  commands    MedicineReservationCommand[]

  @@unique([tenantId, idempotencyKey])
  @@unique([id, tenantId, providerId])
  @@index([tenantId, providerId, status, expiresAt, id])
  @@index([subjectUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, expiresAt, id])
}

model MedicineReservationCommand {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reservationId String              @db.Uuid
  reservation   MedicineReservation @relation(fields: [reservationId, tenantId, providerId], references: [id, tenantId, providerId], onDelete: Restrict)

  providerId String @db.Uuid

  commandType      MedicineReservationCommandType
  idempotencyKey   String                         @db.VarChar(120)
  commandHash      String                         @db.VarChar(64)
  resultingStatus  MedicineReservationStatus
  resultingVersion Int
  createdAt        DateTime                       @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, reservationId, createdAt(sort: Desc)])
}

model MedicineReservationItem {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reservationId String              @db.Uuid
  reservation   MedicineReservation @relation(fields: [reservationId, tenantId, providerId], references: [id, tenantId, providerId], onDelete: Restrict)

