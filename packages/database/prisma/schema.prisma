generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACCESS
}

enum ProviderType {
  PHARMACY
  HOSPITAL
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum ProductCategory {
  MEDICINE
  OTC
  COSMETIC
  AYURVEDIC
  SUPPLEMENT
  BABY_CARE
  PERSONAL_CARE
  MEDICAL_DEVICE
}

enum DosageForm {
  TABLET
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  CAPSULE
  DROPS
  INHALER
  SPRAY
  LOTION
  GEL
  POWDER
  SOLUTION
  SUSPENSION
}

enum RoleType {
  SYSTEM
  TENANT
}

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid

  name        String
  slug        String   @unique
  email       String?  @unique

  isActive    Boolean  @default(true)

  version     Int      @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users                  User[]
  roles                  Role[]
  permissions            Permission[]
  providerVerifications  ProviderVerification[]
  providers              Provider[]

  @@index([slug])
}

model User {
  id            String      @id @default(uuid()) @db.Uuid

  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  email         String
  passwordHash  String

  firstName     String
  lastName      String

  phone         String?

  preferredLanguage String  @default("en")

  status        UserStatus  @default(ACTIVE)

  version       Int         @default(1)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  sessions       UserSession[]
  userRoles      UserRole[]
  privacy        UserPrivacy?
 // auditLogs      SystemAuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserPrivacy {
  id            String   @id @default(uuid()) @db.Uuid

  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sharePhone    Boolean  @default(false)
  shareEmail    Boolean  @default(false)
  allowInAppChat Boolean @default(true)
  privatePickup Boolean  @default(false)
  hideSensitiveNotifications Boolean @default(true)
  preferredLanguage String @default("en")

  version       Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid

  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name         String
  description  String?

  type         RoleType @default(TENANT)

  version      Int      @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  userRoles        UserRole[]
  rolePermissions  RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid

  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name         String
  description  String?

  version      Int      @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid

  userId    String   @db.Uuid
  roleId    String   @db.Uuid

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id            String      @id @default(uuid()) @db.Uuid

  roleId         String      @db.Uuid
  permissionId   String      @db.Uuid

  role           Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission  @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  createdAt      DateTime    @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserSession {
  id             String         @id @default(uuid()) @db.Uuid

  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken   String         @unique

  ipAddress      String?
  userAgent      String?
  deviceName     String?

  expiresAt      DateTime

  status         SessionStatus  @default(ACTIVE)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model ProviderVerification {
  id                        String             @id @default(uuid()) @db.Uuid

  tenantId                  String             @db.Uuid
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType              ProviderType
  status                    VerificationStatus @default(PENDING)

  licenseNumber             String
  licenseExpiryDate         DateTime
  businessRegistrationNumber String
  governmentIdReference     String

  verificationNotes         String?
  submittedAt               DateTime           @default(now())
  verifiedAt                DateTime?
  verifiedBy                String?            @db.Uuid

  version                   Int                @default(1)

  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  deletedAt                 DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([providerType])
}

model Provider {
  id            String       @id @default(uuid()) @db.Uuid

  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  providerType  ProviderType
  businessName  String
  ownerName     String
  email         String
  phone         String
  address       String
  city          String
  state         String
  country       String
  postalCode    String
  latitude      Float
  longitude     Float
  geoHash       String?

  isVerified    Boolean      @default(false)
  isActive      Boolean      @default(true)

  inventory     Inventory[]

  version       Int          @default(1)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([providerType])
  @@index([email])
}

model Product {
  id                  String         @id @default(uuid()) @db.Uuid

  name                String
  genericName         String?
  brand               String
  category            ProductCategory
  subCategory         String?
  description         String?
  manufacturer        String
  dosageForm          DosageForm
  strength            String
  barcode             String?
  requiresPrescription Boolean       @default(false)

  isActive            Boolean        @default(true)
  inventory           Inventory[]

  version             Int            @default(1)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  @@index([category])
  @@index([name])
  @@index([barcode])
}

model Inventory {
  id                String             @id @default(uuid()) @db.Uuid

  providerId        String             @db.Uuid
  provider          Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)

  productId         String             @db.Uuid
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  sku               String?
  batchNumber       String
  expiryDate        DateTime
  quantity          Int
  reservedQuantity  Int                @default(0)
  sellingPrice      Decimal            @db.Decimal(10, 2)
  mrp               Decimal            @db.Decimal(10, 2)
  discountPercentage Decimal            @db.Decimal(5, 2)
  taxPercentage     Decimal            @db.Decimal(5, 2)
  minimumStockLevel  Int               @default(10)

  inStock           Boolean            @default(true)
  isVisible         Boolean            @default(true)

  version           Int                @default(1)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([providerId])
  @@index([productId])
  @@index([expiryDate])
  @@index([providerId, inStock])
}

enum MedicalRecordType {
  PRESCRIPTION
  LAB_REPORT
  XRAY
  MRI
  CT_SCAN
  VACCINATION
  DISCHARGE_SUMMARY
  INSURANCE
  OTHER
}

model MedicalRecord {
  id              String            @id @default(uuid()) @db.Uuid

  userId          String            @db.Uuid

  recordType      MedicalRecordType
  title           String
  description     String?

  fileUrl         String
  fileName        String
  fileSize        Int
  mimeType        String

  recordDate      DateTime
  uploadedAt      DateTime          @default(now())

  version         Int               @default(1)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([recordType])
}

enum ReservationType {
  MEDICINE_PICKUP
  HOSPITAL_APPOINTMENT
  LAB_TEST
  VACCINATION
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid

  userId          String            @db.Uuid
  providerId      String            @db.Uuid

  reservationType ReservationType
  status          ReservationStatus @default(PENDING)

  scheduledAt     DateTime
  notes           String?

  version         Int               @default(1)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledAt])
}
