+import { Module } from '@nestjs/common';
+import { AuditPersistenceModule } from '../audit/audit-persistence.module';
+import { PrismaModule } from '../prisma/prisma.module';
+import { OrganizationOnboardingService } from './organization-onboarding.service';
+
+/**
+ * Deliberately does not import AuthModule: OrganizationOnboardingService
+ * receives the join-code pepper as a plain method parameter rather than
+ * an injected AuthConfigService, specifically so this module's only
+ * dependencies are lower-level (Prisma, audit) and AuthModule can safely
+ * import this module (to wire OrganizationOnboardingService into
+ * RegistrationService/the Google registration path) without creating a
+ * circular module dependency.
+ */
+@Module({
+  imports: [PrismaModule, AuditPersistenceModule],
+  providers: [OrganizationOnboardingService],
+  exports: [OrganizationOnboardingService],
+})
+export class OrganizationModule {}
