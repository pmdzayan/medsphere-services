+/**
+ * Reusable, revocable organization join code (see the accompanying ADR
+ * for this task's coherent V1 model choice: reusable admin-issued codes,
+ * not per-invitee single-use tokens). Possessing a valid code only lets
+ * a public registration request be associated with this tenant -- it
+ * never grants a role or activates a membership by itself; that remains
+ * governed entirely by the existing account-activation policy and the
+ * separate RBAC role-assignment framework.
+ *
+ * The code itself is never persisted: only an HMAC-SHA256 hash (keyed by
+ * ORG_JOIN_CODE_PEPPER, mirroring the same keyed-hash pattern already
+ * accepted for refresh credentials and OTP codes) is stored, so a
+ * database compromise alone cannot recover a working code.
+ */
+model OrganizationJoinCode {
+  id String @id @default(uuid()) @db.Uuid
+
+  tenantId String @db.Uuid
+  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+
+  /// HMAC-SHA256 hex digest of the normalized code. Never the plaintext
+  /// code. Globally unique and looked up directly at redemption time,
+  /// since the client submits only the raw code, not a tenant hint.
+  codeHash String @unique @db.VarChar(64)
+
+  status JoinCodeStatus @default(ACTIVE)
+
+  /// Null means no expiry is enforced; revocation/status remain the
+  /// only lifecycle control in that case.
+  expiresAt DateTime?
+  revokedAt DateTime?
+
+  /// Reusable by design (see model doc) -- tracks how many onboarding
+  /// requests have redeemed this code for operator visibility only. Not
+  /// a single-use consumption counter.
+  redemptionCount Int @default(0)
+
+  createdByUserId String? @db.Uuid
+  createdByUser   User?   @relation("OrganizationJoinCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
+
+  version Int @default(1)
+
+  createdAt DateTime  @default(now())
+  updatedAt DateTime  @updatedAt
+  deletedAt DateTime?
+
+  @@index([tenantId])
+}
+
 model User {
   id String @id @default(uuid()) @db.Uuid
 
