+  const dead = [];
+  if (!backendAlive) dead.push('backend');
+  if (!frontendAlive) dead.push('frontend');
+  console.error(`\n${dead.join(' and ')} process no longer running before "${groupLabel}".`);
+  if (!backendAlive) {
