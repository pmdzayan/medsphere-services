+              AUTH_JWT_PUBLIC_KEY_BASE64: material.publicKeyBase64,
+              AUTH_REFRESH_TOKEN_PEPPER: material.refreshPepperBase64,
+            };
+            for (const [name, value] of Object.entries(required)) {
