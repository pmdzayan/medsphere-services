+# MedSphere V1 alert rules -- provider-neutral, standard Prometheus
+# rule-file syntax. Importable into any Prometheus-compatible alerting
+# system (Prometheus + Alertmanager, or any OTLP/Prometheus-compatible
+# hosted backend) without modification.
+#
+# Every rule declares a bounded evaluation window ("for:") so a single
+# noisy data point never pages anyone; an alert only fires once its
+# condition has held true continuously for that window, and resolves
+# automatically once the condition is no longer true.
+#
+# See docs/operations/v1-observability-runbook.md for the SLO context
+# these thresholds are drawn from, and an explicit statement that these
+# are initial engineering thresholds, not a contractual SLA.
+
+groups:
+  - name: medsphere-v1-availability
+    rules:
+      - alert: MedSphereServiceUnavailable
+        expr: up{job="medsphere-auth-service"} == 0
+        for: 2m
+        labels:
+          severity: critical
+        annotations:
+          summary: 'MedSphere auth-service is unreachable'
+          description: 'The scrape target has been down for 2 minutes.'
+
+      - alert: MedSphereRepeatedReadinessFailure
+        expr: |
+          sum(rate(medsphere_dependency_check_total{outcome="failure"}[5m]))
+          / sum(rate(medsphere_dependency_check_total[5m])) > 0.1
+        for: 5m
+        labels:
+          severity: warning
+        annotations:
+          summary: 'Repeated dependency readiness failures'
+          description: 'More than 10% of readiness checks have failed over 5 minutes.'
+
+      - alert: MedSpherePostgresUnavailable
+        expr: |
+          sum(rate(medsphere_dependency_check_total{dependency="postgresql",outcome="failure"}[5m]))
+          / sum(rate(medsphere_dependency_check_total{dependency="postgresql"}[5m])) > 0.5
+        for: 3m
+        labels:
+          severity: critical
+        annotations:
+          summary: 'PostgreSQL appears unavailable'
+          description: 'Over 50% of PostgreSQL readiness checks have failed for 3 minutes.'
+
+      - alert: MedSphereRedisUnavailable
+        expr: |
+          sum(rate(medsphere_dependency_check_total{dependency="redis",outcome="failure"}[5m]))
+          / sum(rate(medsphere_dependency_check_total{dependency="redis"}[5m])) > 0.5
+        for: 3m
+        labels:
+          severity: critical
+        annotations:
+          summary: 'Redis appears unavailable'
+          description: 'Over 50% of Redis readiness checks have failed for 3 minutes.'
+
+  - name: medsphere-v1-http
