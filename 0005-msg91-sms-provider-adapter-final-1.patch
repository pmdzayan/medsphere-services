diff --git a/apps/auth-service/src/verification/otp/sms-provider-activation.contracts.ts b/apps/auth-service/src/verification/otp/sms-provider-activation.contracts.ts
--- a/apps/auth-service/src/verification/otp/sms-provider-activation.contracts.ts
