+    await waitFor(() => expect(result.current.permissionState).toBe('granted'));
+    expect(window.localStorage.getItem('latitude')).toBeNull();
+    expect(window.localStorage.getItem('longitude')).toBeNull();
+  });
+
+  it('resolves denied and updates permission state on PERMISSION_DENIED', async () => {
+    stubGeolocation((_success, error) =>
+      error?.({
+        code: 1,
+        PERMISSION_DENIED: 1,
+        POSITION_UNAVAILABLE: 2,
+        TIMEOUT: 3,
+      } as GeolocationPositionError),
+    );
+    stubPermissionsQuery('prompt');
+
+    const { result } = renderHook(() => useGeolocationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('prompt'));
+
+    let outcome!: Awaited<ReturnType<typeof result.current.requestLocation>>;
