@@ -0,0 +1,47 @@
+'use client';
+
+import { useCallback, useEffect, useState } from 'react';
+
+/** Browser/device capability state -- never a MedSphere preference (see settings-contract.ts for that). */
+export type NotificationPermissionState = 'unsupported' | 'default' | 'granted' | 'denied';
+
+function isSupported(): boolean {
+  return typeof window !== 'undefined' && 'Notification' in window;
+}
+
+function readPermissionState(): NotificationPermissionState {
+  if (!isSupported()) return 'unsupported';
+  return Notification.permission;
+}
+
+/**
+ * Task 0013: never requests browser notification permission
+ * automatically. requestPermission() must only ever be called from a
+ * user-initiated action, after the caller has already shown an
+ * application-controlled explanation of why -- this hook does not show
+ * that explanation itself (see notification-permission-prompt.tsx),
+ * only wraps the browser API safely.
+ */
+export function useNotificationPermission() {
+  const [permissionState, setPermissionState] = useState<NotificationPermissionState>('default');
+
+  useEffect(() => {
+    setPermissionState(readPermissionState());
+  }, []);
+
+  const requestPermission = useCallback(async (): Promise<NotificationPermissionState> => {
+    if (!isSupported()) {
+      setPermissionState('unsupported');
+      return 'unsupported';
+    }
+    // Browsers ignore a repeated request once the user has already
+    // denied it (no re-prompt) -- reading the result back afterward,
+    // rather than assuming success, keeps this hook's state correct
+    // either way.
+    const result = await Notification.requestPermission();
+    setPermissionState(result);
+    return result;
+  }, []);
+
+  return { permissionState, requestPermission };
+}
