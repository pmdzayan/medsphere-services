index 0000000..4f95070
--- /dev/null
+++ b/apps/web/src/lib/geolocation-permission.ts
@@ -0,0 +1,108 @@
+'use client';
+
+import { useCallback, useEffect, useState } from 'react';
+
+/**
+ * Browser/device capability state -- deliberately separate from any
+ * MedSphere preference (Task 0013 requirement #4). "prompt" means the
+ * browser has not yet been asked and would show its native dialog;
+ * "unsupported" means this browser/context has no Geolocation API at
+ * all (checked safely, never assumed available during SSR).
+ */
+export type GeolocationPermissionState =
+  'unknown' | 'unsupported' | 'prompt' | 'granted' | 'denied';
+
+export type GeolocationOutcome =
+  | { kind: 'granted'; latitude: number; longitude: number }
+  | { kind: 'denied' }
+  | { kind: 'unavailable' }
+  | { kind: 'timeout' }
+  | { kind: 'unsupported' };
+
+function isSupported(): boolean {
+  return typeof navigator !== 'undefined' && 'geolocation' in navigator;
+}
+
+/**
+ * Reads current browser permission state without ever triggering the
+ * native prompt. Uses the Permissions API where available (Chrome,
+ * Firefox, Edge); falls back to "unknown" where it is not (Safari does
+ * not support querying the 'geolocation' permission name), since there
+ * is no safe way to distinguish "not yet asked" from "denied" without
+ * it -- the UI must not guess.
+ */
+async function readPermissionState(): Promise<GeolocationPermissionState> {
+  if (!isSupported()) return 'unsupported';
+  if (typeof navigator.permissions?.query !== 'function') return 'unknown';
+  try {
+    const status = await navigator.permissions.query({
+      name: 'geolocation' as PermissionName,
+    });
+    if (status.state === 'granted') return 'granted';
+    if (status.state === 'denied') return 'denied';
+    return 'prompt';
+  } catch {
+    return 'unknown';
+  }
+}
+
+/**
+ * Task 0013: location permission is requested only when explicitly
+ * invoked by requestLocation() -- this hook never calls the browser
+ * geolocation API on mount or as a side effect of rendering. Coordinates
+ * returned by requestLocation are held only in the caller's own local
+ * state for the duration of one search/action; this hook itself never
+ * stores them anywhere (no localStorage, no server call) -- see the
+ * existing nearby-medicine-search feature for how a caller uses the
+ * result transiently.
+ */
+export function useGeolocationPermission() {
+  const [permissionState, setPermissionState] = useState<GeolocationPermissionState>('unknown');
+
+  useEffect(() => {
+    let cancelled = false;
+    readPermissionState().then((state) => {
+      if (!cancelled) setPermissionState(state);
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const requestLocation = useCallback((): Promise<GeolocationOutcome> => {
+    if (!isSupported()) {
+      setPermissionState('unsupported');
+      return Promise.resolve({ kind: 'unsupported' });
+    }
+
+    return new Promise((resolve) => {
+      navigator.geolocation.getCurrentPosition(
+        (position) => {
+          setPermissionState('granted');
+          resolve({
+            kind: 'granted',
+            latitude: position.coords.latitude,
+            longitude: position.coords.longitude,
+          });
+        },
+        (error) => {
+          if (error.code === error.PERMISSION_DENIED) {
+            setPermissionState('denied');
+            resolve({ kind: 'denied' });
+          } else if (error.code === error.TIMEOUT) {
+            resolve({ kind: 'timeout' });
+          } else {
+            // POSITION_UNAVAILABLE: the browser/OS could not determine a
+            // location (no GPS, no network-based estimate, location
+            // services disabled at the OS level) -- distinct from the
+            // user having denied permission.
+            resolve({ kind: 'unavailable' });
+          }
+        },
+        { enableHighAccuracy: false, timeout: 10_000, maximumAge: 60_000 },
+      );
+    });
+  }, []);
+
+  return { permissionState, requestLocation };
+}
