@@ -0,0 +1,69 @@
+'use client';
+
+/**
+ * Task 0013: the mandatory app-controlled explanation shown BEFORE any
+ * browser permission prompt fires -- for location and, separately, for
+ * notifications. Never auto-dismisses, never hides the decline option,
+ * never makes "Allow"/"Continue" visually deceptive (see the no-dark-
+ * patterns requirement). The caller is responsible for only invoking
+ * the real browser API's request function after onContinue fires.
+ */
+export interface PermissionExplanationDialogProps {
+  readonly open: boolean;
+  readonly title: string;
+  readonly description: string;
+  readonly continueLabel: string;
+  readonly declineLabel: string;
+  readonly onContinue: () => void;
+  readonly onDecline: () => void;
+}
+
+export function PermissionExplanationDialog({
+  open,
+  title,
+  description,
+  continueLabel,
+  declineLabel,
+  onContinue,
+  onDecline,
+}: PermissionExplanationDialogProps) {
+  if (!open) return null;
+
+  return (
+    <div
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="permission-explanation-title"
+      aria-describedby="permission-explanation-description"
+      className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
+    >
+      <div className="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl">
+        <h2 id="permission-explanation-title" className="text-base font-bold text-[#173128]">
+          {title}
+        </h2>
+        <p
+          id="permission-explanation-description"
+          className="mt-2 text-sm leading-6 text-[#536a62]"
+        >
+          {description}
+        </p>
+        <div className="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
+          <button
+            type="button"
+            onClick={onDecline}
+            className="min-h-11 rounded-xl border border-[#17372e]/15 bg-white px-4 text-sm font-bold text-[#264b40] transition hover:border-emerald-700/30"
+          >
+            {declineLabel}
+          </button>
+          <button
+            type="button"
+            onClick={onContinue}
+            className="min-h-11 rounded-xl bg-[#0b2f28] px-4 text-sm font-bold text-white transition hover:bg-[#075f49]"
+          >
+            {continueLabel}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
