+
+afterEach(() => {
+  cleanup();
+  delete (globalThis as { Notification?: unknown }).Notification;
+});
+
+describe('DevicePermissionsSection', () => {
+  it('shows the browser-reported location permission state, distinct from any app preference', async () => {
+    stubGeolocationPermissions('denied');
+    stubNotification('default');
+
+    render(<DevicePermissionsSection />);
+
+    expect(await screen.findAllByText('Blocked in this browser')).not.toHaveLength(0);
