+import { act, renderHook, waitFor } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { useGeolocationPermission } from './geolocation-permission';
+
+const originalGeolocation = navigator.geolocation;
+const originalPermissions = navigator.permissions;
+
+afterEach(() => {
+  Object.defineProperty(navigator, 'geolocation', {
+    value: originalGeolocation,
+    configurable: true,
+  });
+  Object.defineProperty(navigator, 'permissions', {
+    value: originalPermissions,
+    configurable: true,
+  });
+  vi.restoreAllMocks();
+});
+
+function stubGeolocation(getCurrentPosition: typeof navigator.geolocation.getCurrentPosition) {
+  Object.defineProperty(navigator, 'geolocation', {
+    value: { getCurrentPosition },
+    configurable: true,
+  });
+}
+
+function stubPermissionsQuery(state: 'granted' | 'denied' | 'prompt') {
+  Object.defineProperty(navigator, 'permissions', {
+    value: { query: vi.fn().mockResolvedValue({ state }) },
+    configurable: true,
+  });
+}
+
+describe('useGeolocationPermission', () => {
+  it('reports unsupported when the browser has no Geolocation API, without ever calling it', async () => {
+    // @ts-expect-error -- intentionally simulating a browser where the
+    // property is truly absent, not merely undefined (defineProperty
+    // with value: undefined would still leave the key present, which
+    // 'geolocation' in navigator would incorrectly treat as supported).
+    delete navigator.geolocation;
+
+    const { result } = renderHook(() => useGeolocationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('unsupported'));
+
+    let outcome!: Awaited<ReturnType<typeof result.current.requestLocation>>;
+    await act(async () => {
+      outcome = await result.current.requestLocation();
+    });
+    expect(outcome).toEqual({ kind: 'unsupported' });
+  });
+
+  it('never calls the browser geolocation API automatically on mount (no auto-prompt)', async () => {
+    const getCurrentPosition = vi.fn();
+    stubGeolocation(getCurrentPosition);
+    stubPermissionsQuery('prompt');
+
+    renderHook(() => useGeolocationPermission());
+    await new Promise((resolve) => setTimeout(resolve, 10));
+
+    expect(getCurrentPosition).not.toHaveBeenCalled();
+  });
+
+  it('reads the initial permission state via the Permissions API without prompting', async () => {
+    stubGeolocation(vi.fn());
+    stubPermissionsQuery('granted');
+
+    const { result } = renderHook(() => useGeolocationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('granted'));
+  });
+
+  it('falls back to "unknown" when the Permissions API is unavailable (e.g. Safari)', async () => {
+    stubGeolocation(vi.fn());
+    Object.defineProperty(navigator, 'permissions', { value: undefined, configurable: true });
+
+    const { result } = renderHook(() => useGeolocationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('unknown'));
+  });
+
+  it('resolves granted with transient coordinates only -- never persists them anywhere', async () => {
+    stubGeolocation((success) =>
+      success({ coords: { latitude: 12.34, longitude: 56.78 } } as GeolocationPosition),
+    );
+    stubPermissionsQuery('prompt');
+
+    const { result } = renderHook(() => useGeolocationPermission());
+    // Let the hook's own mount-time permission read settle first --
+    // otherwise its async resolution could race with, and clobber, the
+    // state update from the explicit request below (a test-ordering
+    // concern only; a real user's click always happens well after
+    // mount).
+    await waitFor(() => expect(result.current.permissionState).toBe('prompt'));
+
+    let outcome!: Awaited<ReturnType<typeof result.current.requestLocation>>;
+    await act(async () => {
+      outcome = await result.current.requestLocation();
+    });
