+import { act, renderHook, waitFor } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { useNotificationPermission } from './notification-permission';
+
+const originalNotification = (globalThis as { Notification?: unknown }).Notification;
+
+afterEach(() => {
+  if (originalNotification === undefined) {
+    delete (globalThis as { Notification?: unknown }).Notification;
+  } else {
+    (globalThis as { Notification?: unknown }).Notification = originalNotification;
+  }
+  vi.restoreAllMocks();
+});
+
+function stubNotification(
+  permission: NotificationPermission,
+  requestPermission: () => Promise<NotificationPermission>,
+) {
+  (globalThis as { Notification?: unknown }).Notification = { permission, requestPermission };
+}
+
+describe('useNotificationPermission', () => {
+  it('reports unsupported when the browser has no Notification API', async () => {
+    delete (globalThis as { Notification?: unknown }).Notification;
+
+    const { result } = renderHook(() => useNotificationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('unsupported'));
+
+    let outcome: Awaited<ReturnType<typeof result.current.requestPermission>>;
+    await act(async () => {
+      outcome = await result.current.requestPermission();
+    });
+    expect(outcome!).toBe('unsupported');
+  });
+
+  it('reads the current default/not-asked state on mount without prompting', async () => {
+    const requestPermission = vi.fn();
+    stubNotification('default', requestPermission);
+
+    renderHook(() => useNotificationPermission());
+    await new Promise((resolve) => setTimeout(resolve, 10));
+
+    expect(requestPermission).not.toHaveBeenCalled();
+  });
+
+  it('reads an already-granted state on mount', async () => {
+    stubNotification('granted', vi.fn());
+
+    const { result } = renderHook(() => useNotificationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('granted'));
+  });
+
+  it('reads an already-denied state on mount', async () => {
+    stubNotification('denied', vi.fn());
+
+    const { result } = renderHook(() => useNotificationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('denied'));
+  });
+
+  it('only requests permission when explicitly invoked, and reflects the granted result', async () => {
+    stubNotification('default', vi.fn().mockResolvedValue('granted'));
+
+    const { result } = renderHook(() => useNotificationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('default'));
+
+    let outcome: Awaited<ReturnType<typeof result.current.requestPermission>>;
+    await act(async () => {
+      outcome = await result.current.requestPermission();
+    });
+
+    expect(outcome!).toBe('granted');
+    await waitFor(() => expect(result.current.permissionState).toBe('granted'));
+  });
+
+  it('reflects a denied result without retrying or nagging', async () => {
+    const requestPermission = vi.fn().mockResolvedValue('denied');
+    stubNotification('default', requestPermission);
+
+    const { result } = renderHook(() => useNotificationPermission());
+    await waitFor(() => expect(result.current.permissionState).toBe('default'));
+
+    await act(async () => {
+      await result.current.requestPermission();
+    });
+    await waitFor(() => expect(result.current.permissionState).toBe('denied'));
+
+    // Calling requestPermission again is the caller's explicit choice
+    // (e.g. a second contextual prompt) -- the hook itself never calls
+    // it automatically or in a loop.
+    expect(requestPermission).toHaveBeenCalledTimes(1);
+  });
+});
