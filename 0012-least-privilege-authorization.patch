+
+describe('PERMISSIONS catalogue', () => {
+  it('never has two keys mapping to the same permission string (no duplicate meaning under different names)', () => {
+    const values = Object.values(PERMISSIONS);
+    expect(new Set(values).size).toBe(values.length);
+  });
+
+  it('recognizes every catalogued permission via isPermissionKey', () => {
+    for (const key of PERMISSION_KEYS) {
+      expect(isPermissionKey(key)).toBe(true);
+    }
+  });
+
+  it('rejects an arbitrary, non-catalogued permission string', () => {
+    expect(isPermissionKey('inventory.delete-everything')).toBe(false);
+    expect(isPermissionKey('*')).toBe(false);
+    expect(isPermissionKey('')).toBe(false);
+  });
+
+  it('never contains a wildcard permission', () => {
+    expect(PERMISSION_KEYS).not.toContain('*');
+    expect(PERMISSION_KEYS.some((key) => key.includes('*'))).toBe(false);
+  });
+});
+
+describe('HEALTHCARE_ROLE_PRESETS -- least-privilege boundaries', () => {
+  it('every preset permission is drawn from the real catalogue -- no invented permission strings', () => {
+    for (const presetName of HEALTHCARE_ROLE_PRESET_NAMES) {
+      for (const permission of HEALTHCARE_ROLE_PRESETS[presetName]) {
+        expect(isPermissionKey(permission)).toBe(true);
+      }
+    }
+  });
+
+  it('never defines a preset named after the reserved TENANT_ADMINISTRATOR role', () => {
+    expect(HEALTHCARE_ROLE_PRESET_NAMES).not.toContain(TENANT_ADMINISTRATOR_ROLE);
+  });
+
+  it('every preset has at least one permission and none are empty scaffolds', () => {
+    for (const presetName of HEALTHCARE_ROLE_PRESET_NAMES) {
+      expect(HEALTHCARE_ROLE_PRESETS[presetName].length).toBeGreaterThan(0);
+    }
+  });
+
+  it('no preset contains a duplicate permission within itself', () => {
+    for (const presetName of HEALTHCARE_ROLE_PRESET_NAMES) {
+      const permissions = HEALTHCARE_ROLE_PRESETS[presetName];
+      expect(new Set(permissions).size).toBe(permissions.length);
+    }
+  });
+
+  it('DOCTOR never receives organization-administration or team-management permissions', () => {
+    const doctor = HEALTHCARE_ROLE_PRESETS.DOCTOR;
+    expect(doctor).not.toContain(PERMISSIONS.organizationSettingsManage);
+    expect(doctor).not.toContain(PERMISSIONS.organizationSettingsRead);
+    expect(doctor).not.toContain(PERMISSIONS.teamMembersRead);
+    expect(doctor).not.toContain(PERMISSIONS.assignmentsManage);
+    expect(doctor).not.toContain(PERMISSIONS.rolesCreate);
+  });
+
+  it('PHARMACIST never receives hospital administration or laboratory compliance permissions', () => {
+    const pharmacist = HEALTHCARE_ROLE_PRESETS.PHARMACIST;
+    expect(pharmacist).not.toContain(PERMISSIONS.organizationSettingsRead);
+    expect(pharmacist).not.toContain(PERMISSIONS.organizationSettingsManage);
+    expect(pharmacist).not.toContain(PERMISSIONS.teamMembersRead);
+    expect(pharmacist).not.toContain(PERMISSIONS.inventoryBatchQuarantine);
+    expect(pharmacist).not.toContain(PERMISSIONS.inventoryQuarantineRead);
+  });
+
+  it('LABORATORY_STAFF never receives pharmacy-specific dispensing/transfer mutation permissions', () => {
+    const lab = HEALTHCARE_ROLE_PRESETS.LABORATORY_STAFF;
+    expect(lab).not.toContain(PERMISSIONS.inventoryStockReceive);
+    expect(lab).not.toContain(PERMISSIONS.inventoryStockTransfer);
+    expect(lab).not.toContain(PERMISSIONS.inventoryStockDamage);
+    expect(lab).not.toContain(PERMISSIONS.organizationSettingsManage);
+  });
+
+  it('SUPPLIER_STAFF never receives clinical/reservation-management or quarantine permissions', () => {
+    const supplier = HEALTHCARE_ROLE_PRESETS.SUPPLIER_STAFF;
+    expect(supplier).not.toContain(PERMISSIONS.inventoryReservationsManage);
+    expect(supplier).not.toContain(PERMISSIONS.inventoryReservationsCreate);
+    expect(supplier).not.toContain(PERMISSIONS.inventoryBatchQuarantine);
+    expect(supplier).not.toContain(PERMISSIONS.organizationSettingsManage);
+  });
+
+  it('AUDITOR is strictly read-only -- no mutation permission of any kind', () => {
+    const mutationPermissions = [
+      PERMISSIONS.rolesCreate,
