+  it('no healthcare preset ever receives role/permission-assignment authority', () => {
+    for (const presetName of HEALTHCARE_ROLE_PRESET_NAMES) {
+      expect(HEALTHCARE_ROLE_PRESETS[presetName]).not.toContain(PERMISSIONS.assignmentsManage);
+      expect(HEALTHCARE_ROLE_PRESETS[presetName]).not.toContain(PERMISSIONS.rolesCreate);
