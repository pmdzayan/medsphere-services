+-- Task 0012: least-privilege authorization framework. Adds the new
+-- permission catalogue entries this task's controller changes require
+-- (team roster visibility split from role-assignment detail; expiry and
+-- quarantine evidence split from generic stock read; organization
+-- settings and notification operations as forward-declared categories
+-- for later tasks to consume). Follows the exact established pattern:
+-- the Permission table is trigger-protected against direct insert/
+-- update/delete outside a migration, and every new permission is
+-- granted to the existing TENANT_ADMINISTRATOR SYSTEM role in every
+-- tenant, matching every prior permission-adding migration.
+
+ALTER TABLE "Permission"
+DISABLE TRIGGER "Permission_reject_insert_update_delete";
+
+INSERT INTO "Permission" ("id", "name", "description")
+VALUES
+  (
+    md5('medsphere:permission:team.members.read')::uuid,
+    'team.members.read',
+    'List team members and their assigned roles in the authenticated tenant'
+  ),
+  (
+    md5('medsphere:permission:inventory.expiry.read')::uuid,
+    'inventory.expiry.read',
+    'Read the expiry worklist for an assigned provider'
+  ),
+  (
+    md5('medsphere:permission:inventory.quarantine.read')::uuid,
+    'inventory.quarantine.read',
+    'Read immutable quarantine evidence for an assigned provider'
+  ),
+  (
+    md5('medsphere:permission:organization.settings.read')::uuid,
+    'organization.settings.read',
+    'Read organization-level settings for the authenticated tenant'
+  ),
+  (
+    md5('medsphere:permission:organization.settings.manage')::uuid,
+    'organization.settings.manage',
+    'Manage organization-level settings for the authenticated tenant'
+  ),
+  (
+    md5('medsphere:permission:notification.operations.manage')::uuid,
+    'notification.operations.manage',
+    'Manage notification delivery operations for the authenticated tenant'
+  );
+
+ALTER TABLE "Permission"
+ENABLE TRIGGER "Permission_reject_insert_update_delete";
+
+INSERT INTO "RolePermission" (
+  "id", "tenantId", "roleId", "permissionId", "createdAt"
+)
+SELECT
+  md5(r."id"::text || ':' || p."id"::text)::uuid,
+  r."tenantId",
+  r."id",
+  p."id",
+  CURRENT_TIMESTAMP
+FROM "Role" r
+CROSS JOIN "Permission" p
+WHERE r."name" = 'TENANT_ADMINISTRATOR'
+  AND r."type" = 'SYSTEM'
+  AND r."deletedAt" IS NULL
+  AND p."name" IN (
+    'team.members.read',
+    'inventory.expiry.read',
+    'inventory.quarantine.read',
+    'organization.settings.read',
+    'organization.settings.manage',
+    'notification.operations.manage'
+  );
