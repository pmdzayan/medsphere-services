+  }
+
+  // ---- G. Post-load reliability ----
+  console.log('\n== G. Post-load reliability ==');
+  const liveAfter = await waitForHealth(`${BACKEND}/health/live`, 30_000);
+  const readyAfter = await waitForHealth(`${BACKEND}/health/ready`, 30_000);
