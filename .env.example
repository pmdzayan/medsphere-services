# Copy to .env and fill in real values locally. Never commit a filled-in .env.
# Every service fails fast at startup if a variable it needs is missing —
# there are intentionally no insecure defaults baked into compose/config.

# --- Postgres ---
POSTGRES_USER=medsphere_dev
POSTGRES_PASSWORD=
POSTGRES_DB=medsphere_dev
POSTGRES_PORT=5432
# Host-side Prisma commands use localhost. Application containers construct
# their own postgres-service URL in compose/docker-compose.services.yml.
DATABASE_URL=postgresql://medsphere_dev:CHANGE_ME@localhost:5432/medsphere_dev?schema=public

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT=6379
# Host-side auth-service (pnpm --filter @medsphere/auth-service dev) uses
# localhost, matching DATABASE_URL above. Only a containerized auth-service
# (compose/docker-compose.services.yml) uses the redis:6379 hostname, and
# that file already sets REDIS_CLUSTER_URL itself -- it does not read this
# value.
REDIS_CLUSTER_URL=redis://:CHANGE_ME@localhost:6379

# --- Auth ---
# Generate an RSA key pair and refresh-token pepper for local development
# with: node scripts/generate-dev-keys.js
# Store each complete PEM document as padded base64; never commit generated
# keys or reuse development keys.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_ISSUER=https://auth.local.medsphere.test
AUTH_JWT_AUDIENCE=medsphere-api
AUTH_JWT_KEY_ID=local-development-key
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_IDLE_TTL_SECONDS=604800
AUTH_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
# At least 32 cryptographically random bytes encoded as padded base64.
# Also generated by: node scripts/generate-dev-keys.js
AUTH_REFRESH_TOKEN_PEPPER=
# At least 32 cryptographically random bytes encoded as padded base64.
# Also generated by: node scripts/generate-dev-keys.js
AUTH_OTP_PEPPER=
# At least 32 cryptographically random bytes encoded as padded base64.
# Peppers the organization join-code hash (see Task 0010's ADR).
ORG_JOIN_CODE_PEPPER=
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
# API documentation is opt-in and should remain disabled on public production edges.
ENABLE_SWAGGER=false

# Query logs may contain sensitive parameter values. Keep disabled unless a
# developer is diagnosing a sanitized local dataset.
ENABLE_PRISMA_QUERY_LOGGING=false

# Rejected prototype HTTP applications fail closed. Set this only for direct,
# non-production development.
ENABLE_UNACCEPTED_PROTOTYPE_SERVICES=false

# --- Kafka ---
KAFKA_BROKERS=kafka:9092

# --- Testing ---
# Set to "true" to execute PostgreSQL and Redis authentication integration
# tests.  When unset, false, or any value other than the exact string "true",
# infrastructure-dependent suites are skipped.  GitHub CI sets this to "true"
# and provides real PostgreSQL and Redis service containers.
RUN_AUTH_INFRASTRUCTURE_TESTS=false

# --- Logging ---
LOG_LEVEL=info

# --- Metrics & telemetry export (see docs/operations/v1-observability-runbook.md) ---
# Application metrics are always collected in-process and exposed at
# GET /metrics (Prometheus text exposition) regardless of the settings
# below -- these variables control only the OPTIONAL push export to an
# external OTLP-compatible collector, which is disabled by default and
# local-safe: leaving every value below unset is a fully supported,
# safe configuration.
TELEMETRY_METRICS_EXPORT_ENABLED=false
TELEMETRY_SERVICE_NAME=auth-service
# Must be HTTPS; enabling export without a valid HTTPS endpoint fails
# closed at startup rather than silently exporting nowhere or over
# plain HTTP.
TELEMETRY_METRICS_EXPORT_ENDPOINT=
TELEMETRY_METRICS_EXPORT_TIMEOUT_MS=5000
TELEMETRY_METRICS_EXPORT_INTERVAL_MS=60000
# Optional: name of another env var holding a collector auth header
# value (e.g. "Bearer <token>"). Never put the credential itself here.
TELEMETRY_METRICS_EXPORT_HEADER_CREDENTIAL_REFERENCE=

# Example secret variable name referenced by
# TELEMETRY_METRICS_EXPORT_HEADER_CREDENTIAL_REFERENCE. When enabling a
# real collector, set:
# TELEMETRY_METRICS_EXPORT_HEADER_CREDENTIAL_REFERENCE=MEDSPHERE_OTLP_COLLECTOR_AUTH_HEADER
# and provide MEDSPHERE_OTLP_COLLECTOR_AUTH_HEADER through the
# deployment secret store. Do not commit a real credential value.
MEDSPHERE_OTLP_COLLECTOR_AUTH_HEADER=

# Google authentication
GOOGLE_OAUTH_CLIENT_ID=

NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Notification email provider
# Disabled by default. Enable only when a real SMTP-compatible provider is configured.
NOTIFICATION_EMAIL_PROVIDER_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER_KEY=
NOTIFICATION_EMAIL_PROVIDER_CREDENTIAL_REFERENCE=
NOTIFICATION_EMAIL_PROVIDER_TIMEOUT_MS=5000
NOTIFICATION_EMAIL_FROM_ADDRESS=

# Example secret variable name referenced by
# NOTIFICATION_EMAIL_PROVIDER_CREDENTIAL_REFERENCE.
# When enabling the SMTP provider, set:
# NOTIFICATION_EMAIL_PROVIDER_CREDENTIAL_REFERENCE=MEDSPHERE_NOTIFICATION_SMTP_URL
# and provide MEDSPHERE_NOTIFICATION_SMTP_URL through the deployment secret store.
# Do not commit a real credential value.
MEDSPHERE_NOTIFICATION_SMTP_URL=

# Phone OTP SMS provider (see ADR-023, ADR-024)
# Disabled by default. Production activation is explicit and fail-closed.
OTP_SMS_PROVIDER_ENABLED=false
OTP_SMS_PROVIDER_KEY=
OTP_SMS_PROVIDER_CREDENTIAL_REFERENCE=
OTP_SMS_PROVIDER_TIMEOUT_MS=5000

# When activating MSG91, configure:
# OTP_SMS_PROVIDER_KEY=msg91
# OTP_SMS_PROVIDER_CREDENTIAL_REFERENCE=MSG91_AUTH_KEY
# MSG91_AUTH_KEY is the secret value named by the credential reference.
# MSG91_FLOW_ID is the MSG91 Flow ID used in the /api/v5/flow/ request.
# It is NOT the Indian DLT Template ID; DLT template mapping/approval is
# external provider/telecom configuration. MSG91_SENDER_ID must be the
# configured sender/header and must be DLT-approved where applicable.
# Do not commit real credentials or production identifiers.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=
# Flow variable that receives MedSphere's existing six-digit OTP.
# Keep this aligned with the variable configured in the MSG91 Flow.
MSG91_OTP_FLOW_VARIABLE_NAME=OTP
