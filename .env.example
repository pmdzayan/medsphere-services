# Copy to .env and fill in real values locally. Never commit a filled-in .env.
# Every service fails fast at startup if a variable it needs is missing —
# there are intentionally no insecure defaults baked into compose/config.

# --- Postgres ---
POSTGRES_USER=medsphere_dev
POSTGRES_PASSWORD=
POSTGRES_DB=medsphere_dev
POSTGRES_PORT=5432
# Host-side Prisma commands use localhost. Application containers construct
# their own postgres-service URL in compose/docker-compose.services.yml.
DATABASE_URL=postgresql://medsphere_dev:CHANGE_ME@localhost:5432/medsphere_dev?schema=public

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT=6379
# Host-side auth-service (pnpm --filter @medsphere/auth-service dev) uses
# localhost, matching DATABASE_URL above. Only a containerized auth-service
# (compose/docker-compose.services.yml) uses the redis:6379 hostname, and
# that file already sets REDIS_CLUSTER_URL itself -- it does not read this
# value.
REDIS_CLUSTER_URL=redis://:CHANGE_ME@localhost:6379

# --- Auth ---
# Generate an RSA key pair and refresh-token pepper for local development
# with: node scripts/generate-dev-keys.js
# Store each complete PEM document as padded base64; never commit generated
# keys or reuse development keys.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_ISSUER=https://auth.local.medsphere.test
AUTH_JWT_AUDIENCE=medsphere-api
AUTH_JWT_KEY_ID=local-development-key
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_IDLE_TTL_SECONDS=604800
AUTH_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
# At least 32 cryptographically random bytes encoded as padded base64.
# Also generated by: node scripts/generate-dev-keys.js
AUTH_REFRESH_TOKEN_PEPPER=
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
# API documentation is opt-in and should remain disabled on public production edges.
ENABLE_SWAGGER=false

# Query logs may contain sensitive parameter values. Keep disabled unless a
# developer is diagnosing a sanitized local dataset.
ENABLE_PRISMA_QUERY_LOGGING=false

# Rejected prototype HTTP applications fail closed. Set this only for direct,
# non-production development.
ENABLE_UNACCEPTED_PROTOTYPE_SERVICES=false

# --- Kafka ---
KAFKA_BROKERS=kafka:9092

# --- Testing ---
# Set to "true" to execute PostgreSQL and Redis authentication integration
# tests.  When unset, false, or any value other than the exact string "true",
# infrastructure-dependent suites are skipped.  GitHub CI sets this to "true"
# and provides real PostgreSQL and Redis service containers.
RUN_AUTH_INFRASTRUCTURE_TESTS=false

# --- Logging ---
LOG_LEVEL=info

# Google authentication
GOOGLE_OAUTH_CLIENT_ID=

NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
