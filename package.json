{
  "name": "medsphere-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Healthcare platform monorepo undergoing architecture and security stabilization",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@nestjs/swagger>js-yaml": "5.2.2",
      "express>qs": "6.16.0",
      "postcss": "8.5.23",
      "postcss>nanoid": "3.3.18",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:keys": "node scripts/generate-dev-keys.js",
    "dev:infra": "bash scripts/dev-network-setup.sh && docker compose --env-file .env -f compose/docker-compose.database.yml up -d",
    "dev:infra:down": "docker compose --env-file .env -f compose/docker-compose.database.yml down",
    "dev:app": "turbo run dev --filter=@medsphere/auth-service --filter=@medsphere/web",
    "dev:check": "node scripts/dev-check.js",
    "test": "pnpm test:architecture && turbo run test --concurrency=1",
    "test:architecture": "node --test scripts/architecture-boundary-check.spec.js scripts/brand-audit.spec.js scripts/browser-permission-boundary-check.spec.js && node scripts/architecture-boundary-check.js && node scripts/brand-audit.js && node scripts/browser-permission-boundary-check.mjs && node scripts/i18n-hardcoded-ui-audit.mjs",
    "audit:brand": "node scripts/brand-audit.js",
    "test:cov": "turbo run test:cov --concurrency=1",
    "lint": "turbo run lint",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "db:validate": "pnpm --filter @medsphere/database prisma:validate",
    "db:deploy": "pnpm --filter @medsphere/database prisma:deploy",
    "db:status": "pnpm --filter @medsphere/database prisma:status",
    "db:drift": "pnpm --filter @medsphere/database prisma:drift",
    "db:verify": "pnpm --filter @medsphere/database prisma:verify",
    "db:verify-upgrade": "pnpm --filter @medsphere/database prisma:verify-upgrade",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "postinstall": "pnpm --filter @medsphere/database prisma:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-node": "10.9.2",
    "turbo": "^1.13.0",
    "typescript": "^5.3.3"
  }
}
